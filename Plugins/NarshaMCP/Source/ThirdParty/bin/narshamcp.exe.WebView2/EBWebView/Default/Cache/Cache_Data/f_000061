<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NarshaADK Dashboard</title>
  <link rel="icon" type="image/png" href="/dashboard/logo.png">
  <link rel="stylesheet" href="/dashboard/style.css">
</head>
<body>
  <header>
    <div class="header-left">
      <h1>Narsha<span style="color:#5A9BD5">ADK</span><span id="version" class="version-tag">v-.-.-</span></h1>
    </div>
    <div class="header-right">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:14px;height:14px;color:var(--text-dim);flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg><select id="header-lang-select" class="header-lang-select" onchange="I18N.setLang(this.value)"></select>
      <span id="connection-status" class="badge badge-green" data-i18n="header.connected">Connected</span>
    </div>
  </header>

  <!--
    Issue #10769: Configuration-error banner. Hidden by default; populated by
    applyDegradedBanner() in dashboard.js when /api/daemon/status reports
    `degraded_mode: true` (PR 5+). Each <li> in #config-error-list shows one
    DegradedReason with its localized fix instruction.
  -->
  <div id="config-error-banner" class="config-error-banner" style="display:none" role="alert" aria-live="assertive">
    <div class="config-error-banner__icon" aria-hidden="true">⚠</div>
    <div class="config-error-banner__content">
      <h3 class="config-error-banner__title" data-i18n="degraded.title">Configuration Error</h3>
      <p class="config-error-banner__subtitle" data-i18n="degraded.subtitle">The daemon is running in dashboard-only mode. Fix the issues below to enable MCP tools.</p>
      <ul id="config-error-list" class="config-error-banner__list"></ul>
      <!--
        Issue #11147: per-error recovery suggestion list. Populated by
        renderRecoverySuggestions() in dashboard.js when ConfigErrorApi
        carries a non-empty suggested_paths array. Hidden when the resolve
        chain returns nothing so the banner falls back to the existing
        generic message.
      -->
      <div id="recovery-suggestions" class="recovery-suggestions" hidden></div>
      <div class="config-error-banner__actions">
        <button type="button" class="config-error-banner__btn" onclick="restartDaemon()" data-i18n="degraded.action.restart">Restart Daemon</button>
        <!--
          Spawn a Claude Code session at the daemon's project_path with a
          pre-filled /mcp-doctor prompt. Disabled state + inline result
          message are managed by openInClaudeCode() in dashboard.js.
        -->
        <button type="button" id="open-claude-code-btn" class="config-error-banner__btn config-error-banner__btn--ghost" onclick="openInClaudeCode()" data-i18n="degraded.action.open_claude_code">Open in Claude Code →</button>
        <button type="button" class="config-error-banner__btn config-error-banner__btn--ghost" onclick="copyFixGuide()" data-i18n="degraded.action.copy_guide">Copy Fix Guide</button>
      </div>
      <!-- Inline result line populated by openInClaudeCode(). Hidden by default. -->
      <div id="open-claude-code-result" class="config-error-banner__inline-result" hidden></div>
    </div>
  </div>

  <!-- Status Bar (single line) -->
  <span id="symbols-value" style="display:none">--</span>
  <div class="status-bar">
    <div class="status-chip status-chip--cyan">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
      <span class="status-chip-label" data-i18n="status.cpu">CPU</span>
      <span class="status-chip-value" id="cpu-value">--</span>
      <span class="status-chip-label">%</span>
    </div>
    <div class="status-chip status-chip--cyan status-chip--clickable" style="cursor:pointer" onclick="showMemoryBreakdown()" data-i18n-title="status.click_memory">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
      <span class="status-chip-label" data-i18n="status.memory">Memory</span>
      <span class="status-chip-value" id="memory-value">--</span>
      <span class="status-chip-label">MB</span>
    </div>
    <div class="status-chip status-chip--dim status-chip--clickable" style="flex:1;min-width:0;cursor:pointer" onclick="openFolder('project-path')" data-i18n-title="status.click_folder">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      <span class="status-chip-label" data-i18n="status.project">Project</span>
      <span class="status-chip-value" id="project-path" style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">--</span>
    </div>
    <div class="status-chip status-chip--dim status-chip--clickable" style="flex:1;min-width:0;cursor:pointer" onclick="openFolder('engine-path')" data-i18n-title="status.click_folder">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      <span class="status-chip-label" data-i18n="status.engine">Engine</span>
      <span class="status-chip-value" id="engine-path" style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">--</span>
    </div>
  </div>

  <nav class="tabs">
    <button class="tab active" data-tab="dashboard"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span data-i18n="nav.dashboard">Dashboard</span></button>

    <button class="tab" data-tab="settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.604.852.997 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span data-i18n="nav.settings">Settings</span></button>
  </nav>

  <!-- Telemetry consent overlay (Issue #7860, GDPR opt-in, 05_cover.html theme) -->
  <div id="consent-overlay" class="consent-overlay" style="display:none">
    <!-- Background: faint C++ code watermark (from 05_cover.html) -->
    <div class="cover-bg-code">
      <div>UCLASS(BlueprintType, Blueprintable)</div>
      <div>class LYRAGAME_API ALyraCharacter</div>
      <div>&nbsp;&nbsp;: public AModularCharacter</div>
      <div>&nbsp;&nbsp;, public IAbilitySystemInterface</div>
      <div>{</div>
      <div>&nbsp;&nbsp;GENERATED_BODY()</div>
      <div></div>
      <div>public:</div>
      <div>&nbsp;&nbsp;UPROPERTY(VisibleAnywhere)</div>
      <div>&nbsp;&nbsp;ULyraPawnExtensionComponent* PawnExtComp;</div>
      <div></div>
      <div>&nbsp;&nbsp;virtual void PossessedBy(AController*) override;</div>
      <div>&nbsp;&nbsp;virtual void SetupPlayerInputComponent(</div>
      <div>&nbsp;&nbsp;&nbsp;&nbsp;UInputComponent*) override;</div>
      <div></div>
      <div>&nbsp;&nbsp;UFUNCTION(BlueprintCallable)</div>
      <div>&nbsp;&nbsp;void TakeDamage(float Amount);</div>
    </div>

    <div class="consent-card">
      <!-- Cover hero: logo + title (from 05_cover.html) -->
      <div class="consent-hero">
        <img src="/dashboard/logo.png" class="cover-logo" alt="NarshaADK">
        <div class="cover-product-name">NARSHA<span>ADK</span></div>
        <p class="cover-subtitle">Unreal Engine C++ &amp; Blueprint ADK Server</p>
      </div>

      <!-- Consent body card -->
      <div class="consent-body">
        <div class="consent-body-inner">
          <p class="consent-title" data-i18n="consent.title">Anonymous Usage Data</p>
          <p class="consent-desc">
            <span data-i18n="consent.desc">Help improve NarshaADK by sharing anonymous usage statistics.</span><br>
            <span data-i18n="consent.desc2">No source code, file paths, or personal information is ever collected.</span>
          </p>
          <div class="consent-details">
            <span data-i18n="consent.collected">Collected items:</span>
            <div class="consent-details-list">
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_tool_calls">Tool call counts</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_operations">Operation names</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_params">Parameter names (keys only, no values)</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_exec_time">Execution time</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_routing_server">Routing server (NarshaMCP vs Epic)</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_session">Session duration</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_errors">Error categories</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_version">MCP version</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_engine">UE engine version</span></div>
              <div class="consent-details-item"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="2.5" fill="#5A9BD5"/></svg><span data-i18n="consent.item_os">OS type</span></div>
            </div>
          </div>
          <div class="consent-note" data-i18n="consent.note">
            You can change this anytime in Settings tab or with NARSHA_TELEMETRY_DISABLED=1
          </div>
        </div>
        <div class="consent-buttons">
          <button class="consent-btn consent-btn-deny" onclick="setConsent(false)"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="vertical-align:-2px"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><line x1="5" y1="5" x2="11" y2="11" stroke="currentColor" stroke-width="1.5"/></svg> <span data-i18n="consent.deny">Deny</span></button>
          <button class="consent-btn consent-btn-allow" onclick="setConsent(true)"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="vertical-align:-2px"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> <span data-i18n="consent.allow">Allow Anonymous Data</span></button>
        </div>
      </div>
    </div>

    <div class="consent-confirm">
      <div id="consent-confirm-icon"></div>
      <div id="consent-confirm-text" class="consent-confirm-text"></div>
    </div>
  </div>

  <!-- Dashboard Tab (merged Overview + Controls) -->
  <section id="tab-dashboard" class="tab-content active">
    <div class="grid grid--dashboard">
      <!-- Left: Indexing + Categories -->
      <div>
        <div class="card card--status">
          <h2 style="justify-content:space-between"><span style="display:flex;align-items:center;gap:8px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="12" width="4" height="9" rx="1"/><rect x="10" y="8" width="4" height="13" rx="1"/><rect x="17" y="3" width="4" height="18" rx="1"/></svg><span data-i18n="indexing.title">Indexing Progress</span></span><span id="indexing-status" style="font-size:11px;color:var(--green)">--</span></h2>
          <div class="card-body">
            <div id="indexing-container"></div>
            <div id="indexing-error"></div>
          </div>
        </div>
        <div class="card card--status card--categories">
          <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg><span data-i18n="categories.title">Categories</span></h2>
          <div class="card-body">
            <div id="pdb-categories"></div>
            <div id="meta-categories" style="margin-top:6px"></div>
          </div>
        </div>
      </div>
      <!-- Right: Controls -->
      <div>
        <div class="card card--controls">
          <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg><span data-i18n="controls.title">Controls</span></h2>
          <div class="card-body">
            <div class="sub-tabs">
              <button class="sub-tab active" onclick="switchSubTab(this,'quick')" data-i18n="controls.quick_actions">Quick Actions</button>
              <button class="sub-tab" onclick="switchSubTab(this,'advanced')" data-i18n="controls.advanced">Advanced</button>
            </div>
            <div id="subtab-quick" class="sub-tab-content active">
              <div class="action-list">
                <div class="action-item">
                  <button class="action-btn action-btn--primary" onclick="regenerateAll()" data-i18n="controls.regenerate_all">Regenerate All</button>
                  <span class="action-desc" data-i18n="controls.regenerate_all_desc">Rebuild PDB index + Blueprint metadata from scratch</span>
                </div>
                <div class="action-item toggle-item">
                  <div>
                    <span style="font-size:12px;color:var(--text)" data-i18n="controls.engine_source_mode">Engine Source Mode</span>
                    <select id="engine-source-mode" class="config-select" onchange="setEngineSourceMode(this.value)">
                      <option value="disabled" data-i18n="controls.engine_mode_disabled">Disabled</option>
                      <option value="core" data-i18n="controls.engine_mode_core">Core (~2s)</option>
                      <option value="extended" data-i18n="controls.engine_mode_extended">Extended (~10-30s)</option>
                      <option value="full" data-i18n="controls.engine_mode_full">Full (~60s+)</option>
                    </select>
                  </div>
                  <span class="action-desc" data-i18n="controls.engine_source_desc">Engine source scan and parsing scope for call graph. Disabled = OFF. Extended is recommended.</span>
                </div>
                <div class="action-item toggle-item">
                  <div>
                    <span style="font-size:12px;color:var(--text)" data-i18n="controls.engine_parser">Engine Parser</span>
                    <select id="engine-parser" class="config-select" onchange="setEngineParser(this.value)">
                      <option value="on-demand" data-i18n="controls.engine_parser_ondemand">On-Demand</option>
                      <option value="lightweight" data-i18n="controls.engine_parser_lightweight">Lightweight</option>
                      <option value="tree-sitter" data-i18n="controls.engine_parser_treesitter">Tree-Sitter</option>
                    </select>
                  </div>
                  <span class="action-desc" data-i18n="controls.engine_parser_desc">Parser strategy. tree-sitter supplements PDB call graph with ~60% additional edges but uses more memory.</span>
                </div>
                <div class="config-status-panel">
                  <div class="section-title"><span data-i18n="pdb.config_title">PDB Load Config</span> <span style="font-size:10px;color:var(--text-dim)">(<span data-i18n="pdb.startup_note">startup — env vars</span>)</span></div>
                  <div id="pdb-load-status" class="pdb-status-grid" data-i18n="pdb.loading">Loading...</div>
                </div>
              </div>
            </div>
            <div id="subtab-advanced" class="sub-tab-content">
              <div class="action-list">
                <div class="action-item">
                  <button class="action-btn" onclick="runAction('ue_cache_control','get_stats',{})" data-i18n="controls.cache_info">Cache Info</button>
                  <span class="action-desc" data-i18n="controls.cache_info_desc">Show cache size, symbol count, and hit rate</span>
                </div>
                <div class="action-item">
                  <button class="action-btn" onclick="runAction('ue_cache_control','regenerate_metadata',{})" data-i18n="controls.regen_metadata">Regenerate Metadata</button>
                  <span class="action-desc" data-i18n="controls.regen_metadata_desc">Re-scan .uasset files and rebuild Blueprint node metadata</span>
                </div>
                <div class="action-item">
                  <button class="action-btn" onclick="runAction('ue_cache_control','regenerate_pdb',{})" data-i18n="controls.regen_pdb">Regenerate PDB</button>
                  <span class="action-desc" data-i18n="controls.regen_pdb_desc">Re-index PDB debug symbols for C++ symbol search</span>
                </div>
                <div class="action-item">
                  <button class="action-btn" onclick="runAction('ue_cache_control','validate_paths',{})" data-i18n="controls.check_paths">Check Paths</button>
                  <span class="action-desc" data-i18n="controls.check_paths_desc">Verify project and engine paths are valid and accessible</span>
                </div>
                <div class="action-item">
                  <button class="action-btn" onclick="runAction('ue_cache_control','load_modules',{})" data-i18n="controls.rebuild_index">Rebuild Index</button>
                  <span class="action-desc" data-i18n="controls.rebuild_index_desc">Reload search index and cross-reference data</span>
                </div>
                <div class="action-item">
                  <button class="action-btn" onclick="runAction('ue_cache_control','unload_modules',{})" data-i18n="controls.free_memory">Free Memory</button>
                  <span class="action-desc" data-i18n="controls.free_memory_desc">Unload cached modules to free RAM (will reload on next query)</span>
                </div>
              </div>
              <div class="card card--result" style="margin-top:8px">
                <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg><span data-i18n="controls.action_result">Action Result</span></h2>
                <div class="card-body">
                  <pre id="dashboard-result" class="result-panel" style="max-height:200px" data-i18n="controls.run_action_placeholder">Run an action to see results.</pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Issue #8082: Asset Health — stale asset detection -->
    <div id="asset-health-section" class="card card--asset-health" style="display:none;margin:0 0 16px 0">
      <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg><span data-i18n="asset_health.title">Asset Health</span></h2>
      <div class="card-body">
        <div id="stale-asset-summary" class="stale-summary">
          <div class="stale-badge" id="stale-badge">
            <span id="stale-count">0</span> <span data-i18n="asset_health.stale_assets">stale assets</span>
          </div>
          <div id="stale-details" class="stale-details">
            <div id="stale-distribution" class="stale-distribution"></div>
            <div id="stale-samples" class="stale-samples"></div>
          </div>
        </div>
        <div class="stale-actions">
          <button class="action-btn action-btn--warning" id="btn-resave-dry" onclick="runResaveAssets('dry_run')" data-i18n="asset_health.dry_run">Dry Run</button>
          <button class="action-btn action-btn--danger" id="btn-resave-stale" onclick="runResaveAssets('stale_only')" data-i18n="asset_health.resave_stale">Resave Stale Assets</button>
        </div>
      </div>
    </div>

    <!-- Issue #12148: Memory Health — process-global guard status with RSS, cap, and transition log -->
    <div id="memory-guard-section" class="card" style="margin:0 0 16px 0;border-left:4px solid var(--text-dim)">
      <h2 style="justify-content:space-between">
        <span style="display:flex;align-items:center;gap:8px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span data-i18n="memory_guard.title">Memory Health</span>
        </span>
        <span id="memory-guard-badge" style="font-size:11px;padding:2px 8px;border-radius:10px;background:var(--bg-dim);color:var(--text-dim)" data-i18n="memory_guard.level_normal">NORMAL</span>
      </h2>
      <div class="card-body">
        <div id="memory-guard-summary" style="display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--text)">
          <div><span data-i18n="memory_guard.rss">RSS</span>: <strong id="memory-guard-rss">--</strong> MB</div>
          <div><span data-i18n="memory_guard.cap">Cap</span>: <strong id="memory-guard-cap">--</strong> MB</div>
          <div><span data-i18n="memory_guard.warn_at">Warn at</span>: <span id="memory-guard-warn">--</span> MB</div>
          <div><span data-i18n="memory_guard.critical_at">Critical at</span>: <span id="memory-guard-critical">--</span> MB</div>
          <div><span data-i18n="memory_guard.rejected">Rejected</span>: <strong id="memory-guard-rejected">0</strong></div>
        </div>
        <div id="memory-guard-message" style="margin-top:8px;font-size:11px;color:var(--text-dim);font-style:italic" data-i18n="memory_guard.message_normal">Memory usage is within safe range.</div>
        <div id="memory-guard-transitions" style="margin-top:10px;max-height:120px;overflow-y:auto;font-size:11px;font-family:monospace;color:var(--text-dim)"></div>
      </div>
    </div>

    <!-- Sessions + Events -->
    <div class="grid grid--bottom">
      <div class="card card--log">
        <h2 style="justify-content:space-between"><span style="display:flex;align-items:center;gap:8px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span data-i18n="sessions.title">Sessions</span></span><span id="session-count" style="color:var(--green);font-size:13px">0</span></h2>
        <div class="card-body">
          <table id="sessions-table">
            <thead><tr><th data-i18n="sessions.id">ID</th><th data-i18n="sessions.host">Host</th><th data-i18n="sessions.requests">Requests</th><th data-i18n="sessions.connected">Connected</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
      <div class="card card--log">
        <h2 style="justify-content:space-between"><span style="display:flex;align-items:center;gap:8px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg><span data-i18n="events.title">Event Log</span></span><span id="uptime" style="font-size:11px;color:var(--text-dim);font-weight:400">--:--:--</span></h2>
        <div class="card-body">
          <div id="event-log" class="event-log"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Settings Tab (Issue #7860, #8288) -->
  <section id="tab-settings" class="tab-content">
    <div class="grid" style="grid-template-columns:1fr">
      <!-- License Status (Issue #8470) -->
      <div class="card card--settings" id="license-card">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg><span data-i18n="settings.license">License</span></h2>
        <div class="card-body">
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.license_status">Status</div>
              <div class="setting-desc" id="settings-license" data-i18n="settings.license_checking">Checking...</div>
            </div>
          </div>
          <div id="license-hint" class="info-banner info-banner--dim" style="display:none">
<span data-i18n="settings.license_hint">Build your UE project and launch the Editor — a license token is generated automatically on first run.</span>
          </div>
        </div>
      </div>
      <!-- Language (Issue #8619) -->
      <div class="card card--settings">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg><span data-i18n="settings.language">Language</span></h2>
        <div class="card-body">
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.language">Language</div>
              <div class="setting-desc" data-i18n="settings.language_desc">Dashboard display language</div>
            </div>
            <div class="setting-toggle-group">
              <select id="language-select" class="config-select" onchange="I18N.setLang(this.value)"></select>
            </div>
          </div>
        </div>
      </div>
      <!-- AI Client Configuration (Issue #8288) -->
      <div class="card card--settings">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg><span data-i18n="settings.ai_clients">AI Client Configuration</span></h2>
        <div class="card-body" id="ai-clients-list">
          <div class="setting-row" style="justify-content:center;color:var(--dim)" data-i18n="settings.ai_loading">Loading...</div>
        </div>
      </div>
      <!-- File Watcher -->
      <div class="card card--settings">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg><span data-i18n="settings.file_watcher">File Watcher</span></h2>
        <div class="card-body">
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.auto_detect">Auto-detect Changes</div>
              <div class="setting-desc" data-i18n="settings.auto_detect_desc">Watch for PDB, .uasset, and .ini file changes and auto-reload indexes</div>
            </div>
            <div class="setting-toggle-group">
              <span id="watcher-status" class="setting-status on" data-i18n="settings.enabled">Enabled</span>
              <button id="watcher-toggle" class="switch on" onclick="toggleWatcher()"></button>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.auto_regen">Auto Regenerate Metadata</div>
              <div class="setting-desc" data-i18n="settings.auto_regen_desc">Automatically regenerate Blueprint metadata when .uasset changes detected</div>
            </div>
            <div class="setting-toggle-group">
              <span id="auto-regen-status" class="setting-status on" data-i18n="settings.enabled">Enabled</span>
              <button id="auto-regen-toggle" class="switch on" onclick="toggleAutoRegen()"></button>
            </div>
          </div>
        </div>
      </div>
      <!-- Memory Management (Issue #8371) -->
      <div class="card" id="memory-card">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M4 12h16"/><path d="M12 4v16"/></svg><span data-i18n="settings.memory">Memory Management</span></h2>
        <div class="card-body">
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.memory_mode">Memory Mode</div>
              <div class="setting-desc" id="memory-mode-desc" data-i18n="settings.ai_loading">Loading...</div>
            </div>
            <select id="memory-mode-select" class="memory-select" disabled>
              <option value="unbounded" data-i18n="settings.memory_unbounded">Unbounded</option>
              <option value="bounded" data-i18n="settings.memory_bounded">Bounded</option>
            </select>
          </div>
          <div class="setting-row" id="memory-limit-row" style="display:none">
            <div>
              <div class="setting-label" data-i18n="settings.memory_limit">Memory Limit (MB)</div>
              <div class="setting-desc" data-i18n="settings.memory_limit_desc">Recommended: 4096 MB (8GB RAM) / 8192 MB (16GB RAM). Hot tier uses ~1100 MB, rest is warm-tier budget.</div>
            </div>
            <input type="number" id="memory-limit-input" class="memory-input" min="1024" max="131072" step="512" value="4096" disabled>
          </div>
          <div id="memory-budget-bar" class="memory-budget" style="display:none">
            <div class="memory-budget-label">
              <span data-i18n="settings.warm_budget">Warm Budget</span>
              <span id="memory-budget-pct">0%</span>
            </div>
            <div class="memory-bar-track">
              <div class="memory-bar-fill" id="memory-bar-fill" style="width:0%"></div>
            </div>
            <div class="memory-budget-detail" id="memory-budget-detail">— / — MB</div>
          </div>
          <div class="setting-row" style="margin-top:8px">
            <div class="info-banner info-banner--warn" style="margin-bottom:0;flex:1" data-i18n="settings.memory_tradeoff"><strong>Speed ↔ Memory tradeoff.</strong> Small projects (Lyra) → Unbounded. Large projects (250GB+) → Bounded.</div>
            <button id="memory-apply-btn" class="action-btn btn-primary" style="margin-left:8px" onclick="applyMemoryTransition()" disabled data-i18n="settings.memory_apply">Apply</button>
            <button id="memory-restart-btn" class="action-btn btn-restart" onclick="restartDaemon()" style="display:none" data-i18n="settings.memory_restart">Restart</button>
          </div>
        </div>
      </div>
      <!-- Memory Transition Progress Overlay -->
      <div id="memory-progress-overlay" class="modal-overlay" style="display:none">
        <div class="modal-card">
          <div class="modal-title" data-i18n="settings.memory_transition">Memory Transition</div>
          <div id="memory-progress-phase" class="modal-message" data-i18n="settings.memory_initializing">Initializing...</div>
          <div class="memory-bar-track" style="margin:12px 0">
            <div class="memory-bar-fill" id="memory-progress-bar" style="width:0%;transition:width 0.4s ease"></div>
          </div>
          <div id="memory-progress-pct" style="text-align:center;font-size:13px;color:var(--text-dim)">0%</div>
        </div>
      </div>
      <!-- Engine Documentation (Issue #8453) -->
      <div class="card card--settings" id="engine-docs-card">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg><span data-i18n="settings.engine_docs">Narsha Progressive Docs</span></h2>
        <div class="card-body">
          <p class="setting-desc" style="margin:0 0 12px 0;line-height:1.5" data-i18n-html="settings.engine_docs_desc">
            Links your local Unreal Engine source (custom-engine forks may be unstable) to the
            progressive-disclosure analysis docs that ship with NarshaADK.
            <strong>Hydrated</strong> bundles contain real engine code snippets, class definitions,
            and module breakdowns &mdash; this powers the deeper "explain" and "trace" tools that
            inspect engine internals. <strong>Skeleton</strong> bundles are placeholders only:
            text search still works, but <code>ue_engine_docs</code>, <code>ue_explain</code>,
            and engine-aware code analysis fall back to documentation summaries without source.
          </p>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.engine_docs_state">State</div>
              <div class="setting-desc" id="engine-docs-status" data-i18n="settings.engine_docs_checking">Checking...</div>
            </div>
            <div class="setting-toggle-group">
              <span id="engine-docs-state-badge" class="setting-status off">--</span>
              <button id="rehydrate-btn" class="action-btn btn-primary" onclick="triggerRehydrate()" disabled>Re-hydrate</button>
            </div>
          </div>
          <div id="engine-docs-progress" style="display:none;margin-top:8px">
            <div class="memory-bar-track">
              <div class="memory-bar-fill" id="engine-docs-progress-bar" style="width:0%;transition:width 0.4s ease"></div>
            </div>
            <div id="engine-docs-progress-text" style="text-align:center;font-size:13px;color:var(--text-dim);margin-top:4px">0%</div>
          </div>
          <div id="engine-docs-hint" class="info-banner info-banner--dim" style="display:none;margin-top:8px"></div>
        </div>
      </div>
      <!-- Privacy & Telemetry -->
      <div class="card card--settings">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span data-i18n="settings.privacy">Privacy &amp; Telemetry</span></h2>
        <div class="card-body">
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.anonymous_data">Anonymous Usage Data</div>
              <div class="setting-desc" data-i18n="settings.anonymous_data_desc">Tool call counts, operation names, parameter names, execution time, routing server (NarshaMCP vs Epic), session duration, error categories, MCP version, UE engine version, OS type</div>
            </div>
            <div class="setting-toggle-group">
              <span id="telemetry-status" class="setting-status off" data-i18n="settings.disabled">Disabled</span>
              <button id="telemetry-toggle" class="switch" onclick="toggleConsent()"></button>
            </div>
          </div>
        </div>
      </div>
      <!-- Server Info -->
      <div class="card card--settings">
        <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg><span data-i18n="settings.server">Server</span></h2>
        <div class="card-body">
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.server_version">Server Version</div>
              <div class="setting-desc" id="settings-version">--</div>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.server_uptime">Uptime</div>
              <div class="setting-desc" id="settings-uptime">--</div>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.server_sessions">Sessions</div>
              <div class="setting-desc" id="settings-sessions">--</div>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.server_project">Project</div>
              <div class="setting-desc clickable-path" id="settings-project" onclick="openFolder(this)">--</div>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.server_engine">Engine</div>
              <div class="setting-desc clickable-path" id="settings-engine" onclick="openFolder(this)">--</div>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.server_binary">MCP Binary</div>
              <div class="setting-desc clickable-path" id="settings-binary" onclick="openFolder(this)">--</div>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.server_executable_path">Daemon Binary Path</div>
              <div class="setting-desc clickable-path" id="settings-executable-path" onclick="openFolder(this)">--</div>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.server_cache">Cache</div>
              <div class="setting-desc clickable-path" id="settings-cache" onclick="openFolder(this)">--</div>
            </div>
          </div>
          <div class="setting-row">
            <div>
              <div class="setting-label" data-i18n="settings.third_party_licenses">Third-Party Licenses</div>
              <div class="setting-desc"><a href="/licenses" target="_blank" style="color:#4fc3f7;text-decoration:underline;cursor:pointer;" data-i18n="settings.view_licenses">View 397 crate licenses</a></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Confirm Modal -->
  <div id="confirm-modal" class="modal-overlay">
    <div class="modal-card">
      <div class="modal-title" data-i18n="modal.confirm">Confirm Action</div>
      <div id="confirm-message" class="modal-message"></div>
      <div class="modal-buttons">
        <button class="action-btn" onclick="closeModal()" data-i18n="modal.cancel">Cancel</button>
        <button class="action-btn btn-danger" id="confirm-ok" data-i18n="modal.confirm_btn">Confirm</button>
      </div>
    </div>
  </div>

  <!-- Issue #7972: License Status Overlay (consent-overlay style) -->
  <div id="license-overlay" class="consent-overlay" style="display:none">
    <div class="cover-bg-code">
      <div>UCLASS(BlueprintType, Blueprintable)</div>
      <div>class LYRAGAME_API ALyraCharacter</div>
      <div>&nbsp;&nbsp;: public AModularCharacter</div>
      <div>{</div>
      <div>&nbsp;&nbsp;GENERATED_BODY()</div>
      <div>&nbsp;&nbsp;UPROPERTY(VisibleAnywhere)</div>
      <div>&nbsp;&nbsp;ULyraPawnExtensionComponent* PawnExtComp;</div>
    </div>
    <!-- Success view -->
    <div id="license-success" class="consent-card" style="display:none">
      <div class="consent-hero">
        <img src="/dashboard/logo.png" class="cover-logo" alt="NarshaADK">
        <div class="cover-product-name">NARSHA<span>ADK</span></div>
        <p class="cover-subtitle">Unreal Engine C++ &amp; Blueprint ADK Server</p>
      </div>
      <div class="consent-confirm" style="display:flex">
        <div class="consent-checkmark"><svg viewBox="0 0 24 24" fill="none" stroke="#3ddc84" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg></div>
        <div class="consent-confirm-text" data-i18n="license.verified">License Verified</div>
      </div>
    </div>
    <!-- Error view -->
    <div id="license-error" class="consent-card" style="display:none">
      <div class="consent-hero">
        <img src="/dashboard/logo.png" class="cover-logo" alt="NarshaADK">
        <div class="cover-product-name">NARSHA<span>ADK</span></div>
        <p class="cover-subtitle">Unreal Engine C++ &amp; Blueprint ADK Server</p>
      </div>
      <div class="consent-body">
        <div class="consent-body-inner" style="text-align:center">
          <div class="consent-deny-mark" style="margin:0 auto 16px"><svg viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="3" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></div>
          <p class="consent-title" style="color:var(--red)" data-i18n="license.error">License Error</p>
          <p id="license-error-message" class="consent-desc"></p>
        </div>
        <div class="consent-buttons">
          <button id="license-open-editor-btn" class="consent-btn consent-btn-deny" style="display:none" onclick="openEditor()"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="vertical-align:-2px"><path d="M8 1v14M1 8h14" stroke="currentColor" stroke-width="1.5"/></svg> <span data-i18n="license.open_editor">Open Editor</span></button>
          <button class="consent-btn consent-btn-allow" style="background:var(--red)" onclick="closeLicenseError()" data-i18n="license.close">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Memory Breakdown Modal (Issue #8040) -->
  <div id="memory-modal" class="modal-overlay">
    <div class="modal-card" style="min-width:400px;max-width:560px">
      <div class="modal-title" data-i18n="modal.memory_breakdown">Memory Breakdown</div>
      <div id="memory-breakdown-content" class="modal-message" style="max-height:60vh;overflow-y:auto"></div>
      <div class="modal-buttons">
        <button class="action-btn" onclick="closeMemoryModal()" data-i18n="modal.close">Close</button>
      </div>
    </div>
  </div>

  <div id="toast-container"></div>
  <script src="/dashboard/app.js"></script>
</body>
</html>
