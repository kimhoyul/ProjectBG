/* NarshaADK Dashboard - Unreal Engine 5 Editor Theme */
/* Fonts: system stack (no external CDN dependency for air-gapped environments) */

:root {
  /* UE5 Editor Palette */
  --bg:          #242424;
  --bg-card:     #2d2d2d;
  --bg-input:    #1a1a1a;
  --bg-header:   #333333;
  --bg-toolbar:  #2d2d2d;
  --border:      #3a3a3a;
  --border-light:#4a4a4a;
  --text:        #d4d4d4;
  --text-dim:    #808080;
  --text-bright: #ffffff;
  --accent:      #0d82d1;
  --accent-dim:  #0a5f99;
  --green:       #3ddc84;
  --yellow:      #dba800;
  --red:         #e04040;
  --cyan:        #56c8d8;
  --orange:      #e78c45;
  --radius:      4px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Roboto', 'Segoe UI', sans-serif;
  background: var(--bg);
  color: var(--text);
  height: 100vh;
  font-size: 13px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── Header (UE5 toolbar style) ── */
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 14px;
  background: var(--bg-header);
  border-bottom: 1px solid #1a1a1a;
}

.header-left { display: flex; align-items: center; gap: 10px; }
.header-right { display: flex; align-items: center; gap: 8px; }
h1 { font-size: 18px; font-weight: 600; color: var(--text-bright); letter-spacing: 0.5px; display: flex; align-items: baseline; gap: 0; }

.version-tag {
  font-size: 9px;
  font-weight: 400;
  color: var(--text-dim, #666);
  margin-left: 6px;
  letter-spacing: 0;
  vertical-align: super;
}

.header-lang-select {
  padding: 2px 6px;
  font-size: 11px;
  background: var(--bg-input, #1e1e1e);
  border: 1px solid var(--border, #333);
  border-radius: 4px;
  color: var(--text-dim, #888);
  cursor: pointer;
  outline: none;
}
.header-lang-select:focus { border-color: var(--accent, #5A9BD5); }

.badge {
  padding: 2px 6px;
  border-radius: var(--radius);
  font-size: 11px;
  font-family: 'Consolas', 'Cascadia Mono', monospace;
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text-dim);
}
.badge-green { background: rgba(61,220,132,0.12); color: var(--green); border-color: rgba(61,220,132,0.3); }
.badge-red { background: rgba(224,64,64,0.12); color: var(--red); border-color: rgba(224,64,64,0.3); }

/* ── Tabs (UE5 panel tabs) ── */
.tabs {
  display: flex;
  gap: 0;
  padding: 0 12px;
  background: var(--bg-toolbar);
  border-bottom: 1px solid #1a1a1a;
}

.tab {
  padding: 7px 16px;
  background: none;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  font-size: 12px;
  font-family: 'Roboto', sans-serif;
  font-weight: 500;
  border-bottom: 3px solid transparent;
  transition: all 0.15s;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 5px;
}
.tab svg { width: 14px; height: 14px; opacity: 0.5; transition: opacity 0.15s; }
.tab:hover { color: var(--text); background: var(--bg-header); }
.tab:hover svg { opacity: 0.8; }
.tab.active { color: var(--accent); border-bottom-color: var(--accent); }
.tab.active svg { opacity: 1; color: var(--accent); }

/* ── Tab Content ── */
.tab-content { display: none; padding: 10px 12px; overflow: hidden; flex: 1; min-height: 0; }
.tab-content.active { display: flex; flex-direction: column; }
#tab-settings.active { overflow-y: auto; } /* Issue #8288: Settings needs scroll */

/* ── Status Bar ── */
.status-bar {
  display: flex;
  gap: 8px;
  padding: 8px 12px;
  background: var(--bg-toolbar);
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  font-family: 'Roboto', 'Segoe UI', sans-serif;
  flex-wrap: wrap;
}

.status-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text-dim);
  font-size: 11px;
}
.status-chip svg { width: 14px; height: 14px; flex-shrink: 0; opacity: 0.6; }
.status-chip-label { color: var(--text-dim); }
.status-chip-value { color: var(--text-bright); font-weight: 700; }
.status-chip-value.green { color: var(--green); }
.status-chip--blue { border-left: 3px solid var(--accent); }
.status-chip--cyan { border-left: 3px solid var(--cyan); }
.status-chip--green { border-left: 3px solid var(--green); }
.status-chip--yellow { border-left: 3px solid var(--yellow); }
.status-chip--dim { border-left: 3px solid var(--text-dim); }
.status-chip--clickable:hover { background: rgba(255,255,255,0.06); border-color: var(--border-light); }

/* Legacy compat */
.status-item {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--text-dim);
}
.status-item .value { color: var(--text-bright); font-weight: 700; }
.status-item .value.green { color: var(--green); }

/* ── Grid ── */
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 8px; }

/* ── Cards (UE5 panel style) ── */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 8px;
  overflow: hidden;
  transition: border-color 0.2s;
}
.card:hover { border-color: var(--border-light); }
.card--status { border-top: 3px solid var(--green); }
.card--controls { border-top: 3px solid var(--accent); }
.card--log { border-top: 3px solid var(--cyan); }
.card--build { border-top: 3px solid var(--orange); }
.card--result { border-top: 3px solid var(--text-dim); }
.card--settings { border-top: 3px solid var(--accent); }
.card--danger { border-top: 3px solid var(--red); }
.card--editor { border-top: 3px solid var(--green); }
.card--search { border-top: 3px solid var(--cyan); }

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 10px;
  background: var(--bg-header);
  border-bottom: 1px solid var(--border);
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-dim);
}

.card h2 {
  padding: 7px 10px;
  background: var(--bg-header);
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.card h2 svg { width: 16px; height: 16px; opacity: 0.5; flex-shrink: 0; }

.card-body { padding: 8px 10px; }

/* ── Tables ── */
table { width: 100%; border-collapse: collapse; font-size: 11px; }
th {
  text-align: left;
  color: var(--text-dim);
  padding: 6px 8px;
  border-bottom: 2px solid var(--border);
  background: rgba(255,255,255,0.02);
  font-weight: 700;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.3px;
}
td {
  padding: 5px 8px;
  border-bottom: 1px solid rgba(58,58,58,0.3);
  font-family: 'Consolas', 'Cascadia Mono', monospace;
  font-size: 11px;
}
tbody tr:nth-child(even) { background: rgba(255,255,255,0.015); }
tbody tr:hover { background: rgba(13,130,209,0.06); }
tbody tr { transition: background 0.1s; }
.empty-state { text-align: center; padding: 20px; color: var(--text-dim); }
.empty-state svg { width: 32px; height: 32px; margin-bottom: 8px; opacity: 0.3; }
.empty-state p { font-size: 12px; }

/* ── Progress bars (UE5 style - flat, sharp) ── */
.progress-row { margin-bottom: 6px; }
.progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  margin-bottom: 2px;
  font-family: 'Roboto', 'Segoe UI', sans-serif;
}
.progress-label .label { color: var(--text); font-weight: 500; }
.progress-label .detail { color: var(--text-dim); font-weight: 400; }
.progress-bar {
  height: 10px;
  background: #1a1a1a;
  border-radius: 5px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 5px;
  transition: width 0.5s ease;
}
.progress-fill.green { background: linear-gradient(90deg, #2cb86e, #3ddc84); }
.progress-fill.cyan { background: linear-gradient(90deg, #0a6faa, #0d82d1); }
.progress-fill.yellow { background: linear-gradient(90deg, #b88d00, #dba800); }
.progress-fill.complete { background: linear-gradient(90deg, #2cb86e, #3ddc84); }
.progress-fill:not(.complete) { opacity: 0.9; }

@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.status-item .value.active { color: var(--yellow); }

/* ── Categories ── */
.category-section-title {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
  color: var(--text-dim); padding: 6px 0 4px; border-bottom: 1px solid var(--border); margin-bottom: 4px;
}
.category-chip {
  display: flex; align-items: center; gap: 8px;
  padding: 3px 8px; border-radius: var(--radius);
  font-size: 11px; font-family: 'Roboto', 'Segoe UI', sans-serif;
  margin-bottom: 1px; transition: background 0.1s;
}
.category-chip:hover { background: rgba(255,255,255,0.03); }
.category-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.category-dot.done { background: var(--green); }
.category-dot.pending { background: var(--text-dim); }
.category-name { color: var(--text); flex: 1; }
.category-badge {
  padding: 1px 6px; border-radius: 3px; font-size: 11px; font-weight: 400;
  font-family: 'Roboto', 'Segoe UI', sans-serif;
}
.category-badge.done { background: rgba(255,255,255,0.06); color: var(--green); }
.category-badge.pending { background: rgba(255,255,255,0.04); color: var(--text-dim); }
/* Legacy compat */
.category-row {
  display: flex; justify-content: space-between; padding: 2px 0;
  font-size: 11px; font-family: 'Roboto', 'Segoe UI', sans-serif;
}
.category-row .name { color: var(--text); }
.category-row .count { color: var(--text-dim); }
.category-row .status-icon { margin-left: 4px; }
.category-row .status-icon.done { color: var(--green); }
.category-row .status-icon.pending { color: var(--text-dim); }

/* ── Error display ── */
.error-banner {
  padding: 6px 10px;
  background: rgba(224,64,64,0.1);
  border: 1px solid rgba(224,64,64,0.3);
  border-radius: var(--radius);
  color: var(--red);
  font-size: 11px;
  font-family: 'Consolas', 'Cascadia Mono', monospace;
  margin-top: 6px;
}

/* ── Memory bar ── */
.memory-bar {
  height: 4px;
  background: #1a1a1a;
  border-radius: 1px;
  overflow: hidden;
  margin-top: 4px;
}
.memory-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 1px;
  transition: width 0.5s ease;
  width: 0%;
}

/* ── Event log ── */
.event-log {
  max-height: 160px;
  overflow-y: auto;
  font-family: 'Consolas', 'Cascadia Mono', monospace;
  font-size: 11px;
}
.event-entry {
  padding: 4px 8px;
  border-bottom: 1px solid rgba(58,58,58,0.2);
  border-left: 3px solid transparent;
  display: flex;
  gap: 8px;
  align-items: center;
  transition: background 0.1s;
}
.event-entry:nth-child(even) { background: rgba(255,255,255,0.012); }
.event-entry:hover { background: rgba(255,255,255,0.03); }
.event-entry.evt-connect { border-left-color: var(--green); }
.event-entry.evt-disconnect { border-left-color: var(--yellow); }
.event-entry.evt-tool-start { border-left-color: var(--accent); }
.event-entry.evt-tool-end { border-left-color: var(--cyan); }
.event-entry.evt-shutdown { border-left-color: var(--red); }
.event-time { color: var(--text-dim); min-width: 70px; }
.event-badge {
  display: inline-block; padding: 1px 6px; border-radius: 3px;
  font-size: 10px; font-weight: 700; min-width: 80px; text-align: center;
}
.event-badge.connect { background: rgba(61,220,132,0.12); color: var(--green); }
.event-badge.disconnect { background: rgba(219,168,0,0.12); color: var(--yellow); }
.event-badge.tool-start { background: rgba(13,130,209,0.12); color: var(--accent); }
.event-badge.tool-end { background: rgba(86,200,216,0.12); color: var(--cyan); }
.event-badge.shutdown { background: rgba(224,64,64,0.12); color: var(--red); }
/* Legacy compat */
.event-type { min-width: 90px; font-weight: 500; }
.event-type.connect { color: var(--green); }
.event-type.disconnect { color: var(--yellow); }
.event-type.tool-start { color: var(--accent); }
.event-type.tool-end { color: var(--cyan); }
.event-type.shutdown { color: var(--red); }

/* ── Sub-tabs (inside cards) ── */
.sub-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 8px;
  border-bottom: 1px solid var(--border);
}
.sub-tab {
  padding: 4px 12px;
  background: none;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  font-size: 11px;
  font-family: 'Roboto', sans-serif;
  font-weight: 500;
  border-bottom: 2px solid transparent;
  transition: all 0.15s;
}
.sub-tab:hover { color: var(--text); }
.sub-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
.sub-tab-content { display: none; }
.sub-tab-content.active { display: block; }

/* ── Action List (one per row with description) ── */
.action-list { display: flex; flex-direction: column; gap: 6px; }
.action-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.action-item .action-btn { flex-shrink: 0; min-width: 130px; text-align: center; }
.action-desc {
  font-size: 11px;
  color: var(--text-dim);
  line-height: 1.4;
  padding-top: 4px;
}
.toggle-item {
  flex-direction: column;
  gap: 2px;
  padding-top: 4px;
  border-top: 1px solid var(--border);
}
.toggle-item > div { display: flex; align-items: center; gap: 8px; }

/* ── Buttons (UE5 flat style) ── */
.button-group { display: flex; flex-wrap: wrap; gap: 6px; }

.action-btn {
  padding: 7px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg-header);
  color: var(--text);
  cursor: pointer;
  font-size: 11px;
  font-family: 'Roboto', sans-serif;
  font-weight: 500;
  transition: all 0.15s;
}
.action-btn:hover { background: var(--border-light); border-color: var(--border-light); }
.action-btn:active { background: var(--border); }
/* Issue #8267: Primary action button — uses --blue (#61afef) tones for visual prominence */
.action-btn--primary { background: rgba(97,175,239,0.15); color: var(--blue, #61afef); border-color: rgba(97,175,239,0.4); font-weight: 600; }
.action-btn--primary:hover { background: rgba(97,175,239,0.25); border-color: rgba(97,175,239,0.6); }
.action-btn--primary:active { background: rgba(97,175,239,0.35); }
.action-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.btn-danger { border-color: var(--red); color: var(--red); }
.btn-danger:hover { background: rgba(224,64,64,0.1); }

.action-btn.loading {
  position: relative;
  color: transparent;
}
.action-btn.loading::after {
  content: '';
  position: absolute;
  inset: 0;
  margin: auto;
  width: 14px;
  height: 14px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ── Toggle ── */
.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0;
  margin-top: 4px;
}

.toggle-btn {
  padding: 3px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg);
  color: var(--red);
  cursor: pointer;
  font-size: 11px;
  font-weight: 500;
}
.toggle-btn.on { color: var(--green); border-color: rgba(61,220,132,0.4); }

/* ── Inputs ── */
.input-row { display: flex; gap: 6px; margin-top: 6px; }
input[type="text"], select {
  flex: 1;
  padding: 5px 8px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 12px;
  font-family: 'Roboto', sans-serif;
}
input[type="text"]:focus, select:focus {
  outline: none;
  border-color: var(--accent);
}

/* ── Config Dropdowns ── */
.config-select {
  padding: 3px 8px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 11px;
  font-family: 'Roboto', sans-serif;
  cursor: pointer;
  min-width: 120px;
}
.config-select:focus { outline: none; border-color: var(--accent); }

/* ── PDB Load Status Panel ── */
.config-status-panel {
  margin-top: 10px;
  padding: 8px 10px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.pdb-status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px 12px;
  margin-top: 6px;
  font-size: 11px;
}
.pdb-status-item {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--text-dim);
}
.pdb-status-item .status-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.pdb-status-item .status-dot.on { background: var(--green); }
.pdb-status-item .status-dot.off { background: var(--red); }
.pdb-status-item .status-dot.disabled { background: var(--text-dim); opacity: 0.5; }
.pdb-status-item .status-dot.loaded { background: var(--green); }
.pdb-status-item .status-dot.pending { background: #ffa726; }
.pdb-status-item .status-dot.failed { background: var(--red); }
.pdb-status-item .status-dot.needs-regen { background: var(--orange); }
.pdb-status-item .needs-regen-text { color: var(--orange); }

/* ── Action Card Grid (Build/Editor tabs) ── */
.action-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.action-card {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  padding: 16px 12px; background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--radius); cursor: pointer; transition: all 0.15s;
  text-align: center; color: var(--text); font-family: 'Roboto', sans-serif;
}
.action-card:hover { border-color: var(--accent); background: rgba(13,130,209,0.04); }
.action-card:active { background: rgba(13,130,209,0.08); }
.action-card svg { width: 28px; height: 28px; color: var(--accent); opacity: 0.7; transition: opacity 0.15s; }
.action-card:hover svg { opacity: 1; }
.action-card-title { font-size: 12px; font-weight: 600; color: var(--text-bright); }
.action-card-desc { font-size: 10px; color: var(--text-dim); line-height: 1.3; }
.action-card--green:hover { border-color: var(--green); background: rgba(61,220,132,0.04); }
.action-card--green svg { color: var(--green); }
.action-card--red:hover { border-color: var(--red); background: rgba(224,64,64,0.04); }
.action-card--red svg { color: var(--red); }
.action-card--orange:hover { border-color: var(--orange); background: rgba(231,140,69,0.04); }
.action-card--orange svg { color: var(--orange); }

/* ── Search (removed in Issue #7944) ── */

/* ── Result panel ── */
.result-panel {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 8px 10px;
  font-family: 'Consolas', 'Cascadia Mono', monospace;
  font-size: 11px;
  max-height: 350px;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-all;
  color: var(--text-dim);
}

/* ── Toast ── */
#toast-container {
  position: fixed;
  top: 12px;
  right: 12px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.toast {
  padding: 8px 14px;
  border-radius: var(--radius);
  font-size: 12px;
  animation: slideIn 0.2s ease;
  max-width: 360px;
  font-family: 'Roboto', sans-serif;
}
.toast-success { background: rgba(61,220,132,0.12); border: 1px solid rgba(61,220,132,0.3); color: var(--green); }
.toast-error { background: rgba(224,64,64,0.12); border: 1px solid rgba(224,64,64,0.3); color: var(--red); }
.toast-info { background: rgba(86,200,216,0.12); border: 1px solid rgba(86,200,216,0.3); color: var(--cyan); }

/* Issue #10769 PR 6: config-changed toast (project_watcher fired on
 * .uproject / .mcp.json / .env modification). Wider than info toast to
 * fit the inline Restart-Daemon button; orange theme borrows from
 * the existing --orange palette so the action stands out vs. info.
 */
.toast--config-changed {
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: 480px;
  background: rgba(231, 140, 69, 0.12);
  border: 1px solid rgba(231, 140, 69, 0.4);
  color: #ffd6a0;
}
.toast--config-changed .toast-message { flex: 1 1 auto; }
.toast-action {
  flex: 0 0 auto;
  background: rgba(231, 140, 69, 0.4);
  color: #fff;
  border: none;
  padding: 4px 12px;
  border-radius: var(--radius);
  cursor: pointer;
  font-family: var(--font, 'Roboto', sans-serif);
  font-size: 12px;
  font-weight: 500;
  transition: background 120ms ease;
}
.toast-action:hover { background: rgba(231, 140, 69, 0.65); }

@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

/* ── Confirm Modal ── */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 2000;
  align-items: center;
  justify-content: center;
}
.modal-overlay.visible { display: flex; }
.modal-card {
  background: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: 4px;
  padding: 20px 24px;
  min-width: 340px;
  max-width: 480px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
}
.modal-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-bright);
  margin-bottom: 12px;
}
.modal-message {
  font-size: 13px;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 20px;
}
.modal-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}
.modal-buttons .action-btn { min-width: 80px; text-align: center; }

/* ── Indexing active indicator ── */
.indexing-dots { display:inline }
.indexing-dots span { display:inline-block; animation: dotPulse 0.8s infinite; }
.indexing-dots span:nth-child(1) { animation-delay: 0s; }
.indexing-dots span:nth-child(2) { animation-delay: 0.15s; }
.indexing-dots span:nth-child(3) { animation-delay: 0.3s; }
@keyframes dotPulse { 0% { opacity:0.15 } 50% { opacity:1 } 100% { opacity:0.15 } }

/* ── Issue #7972: License Overlay (reuses consent-overlay styles) ── */
/* No extra CSS needed — consent-overlay, consent-card, consent-hero,
   consent-confirm, consent-checkmark, consent-deny-mark are reused. */

/* ── Scrollbar (UE5 thin) ── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--border-light); }

/* ── Consent Overlay (Issue #7860, 05_cover.html theme) ── */
.consent-overlay {
  position:fixed; inset:0; z-index:9999;
  background:#242424;
  background-image:radial-gradient(ellipse at 50% 35%, rgba(90,155,213,0.18) 0%, transparent 60%);
  display:flex; align-items:center; justify-content:center;
  animation:fadeIn .4s ease; overflow:hidden;
}
@keyframes fadeIn { from{opacity:0} to{opacity:1} }

/* C++ code watermark background (from 05_cover.html .bg-code) */
.cover-bg-code {
  position:absolute; left:20px; top:40px; bottom:40px; width:280px;
  font-family:'JetBrains Mono',monospace; font-size:11px; line-height:2.0;
  color:rgba(255,255,255,0.06); overflow:hidden; pointer-events:none;
}

.consent-card {
  width:480px; max-width:90vw; z-index:1;
  display:flex; flex-direction:column; align-items:center;
}

/* Hero: logo + large NARSHAMCP title (from 05_cover.html) */
.consent-hero { text-align:center; padding:0 0 28px }
.cover-logo { width:280px; height:auto; margin-bottom:8px }
.cover-product-name {
  font-size:64px; font-weight:900; color:#fff;
  letter-spacing:-3px; line-height:1;
  text-shadow:0 0 80px rgba(90,155,213,0.15);
}
.cover-product-name span { color:#5A9BD5 }
.cover-subtitle { font-size:13px; color:rgba(255,255,255,0.35); font-weight:500; margin-top:8px; letter-spacing:1px }

/* Card body */
.consent-body {
  background:var(--bg-card); border:1px solid var(--border);
  border-radius:12px; width:100%; overflow:hidden;
}
.consent-body-inner { padding:24px }
.consent-title { font-size:15px; font-weight:700; color:var(--text); margin:0 0 8px }
.consent-desc { font-size:12px; color:var(--text-dim); line-height:1.6; margin:0 0 16px }
.consent-details {
  font-size:11px; color:var(--text-dim);
  background:rgba(255,255,255,0.03); padding:10px 14px;
  border-radius:8px; margin-bottom:16px; line-height:1.6;
}
.consent-details span { color:#5A9BD5; font-weight:600 }
.consent-details-list { display:grid; grid-template-columns:1fr 1fr; gap:6px 12px; margin-top:8px }
.consent-details-item { display:flex; align-items:center; gap:8px; font-size:11px; color:var(--text-dim); line-height:1.4 }
.consent-details-item svg { flex-shrink:0 }
.consent-note { font-size:11px; color:rgba(255,255,255,0.3) }
.consent-note b { color:rgba(255,255,255,0.5) }
.consent-note code { color:#5A9BD5; font-size:10px }

.consent-buttons {
  display:flex; gap:10px; padding:16px 24px;
  border-top:1px solid var(--border);
}
.consent-btn {
  padding:12px; border:none; border-radius:8px;
  font-size:13px; font-weight:600; cursor:pointer; transition:background .15s;
  display:inline-flex; align-items:center; justify-content:center; gap:6px;
}
.consent-btn-deny { flex:0 0 auto; padding:12px 24px; background:rgba(255,255,255,0.06); color:var(--text-dim) }
.consent-btn-deny:hover { background:rgba(255,255,255,0.10) }
.consent-btn-allow { flex:1; font-size:14px; background:#5A9BD5; color:#fff }
.consent-btn-allow:hover { background:#4A8BC5 }

/* ── Post-Consent Confirmation Animation ── */
.consent-confirm {
  display:none; flex-direction:column; align-items:center;
  justify-content:center; gap:16px; z-index:2;
}
.consent-overlay.confirmed .consent-card { display:none }
.consent-overlay.confirmed .consent-confirm { display:flex }
.consent-overlay.fade-out { animation:fadeOut .5s ease forwards; animation-delay:.8s }
@keyframes fadeOut { to { opacity:0; pointer-events:none } }
.consent-checkmark {
  width:80px; height:80px; border-radius:50%;
  background:rgba(61,220,132,0.12); border:2px solid var(--green);
  display:flex; align-items:center; justify-content:center;
  animation:scaleIn .4s cubic-bezier(0.34,1.56,0.64,1);
}
.consent-deny-mark {
  width:80px; height:80px; border-radius:50%;
  background:rgba(255,255,255,0.04); border:2px solid var(--text-dim);
  display:flex; align-items:center; justify-content:center;
  animation:scaleIn .4s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes scaleIn { from{transform:scale(0);opacity:0} to{transform:scale(1);opacity:1} }
.consent-checkmark svg, .consent-deny-mark svg { width:40px; height:40px }
.consent-confirm-text { font-size:16px; font-weight:600; color:var(--text-bright); animation:fadeIn .3s ease .4s both }

/* ── Settings Tab ── */
.setting-row { display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--border) }
.setting-row:last-child { border-bottom:none }
.setting-label { font-size:12px; color:var(--text); font-weight:500 }
.setting-desc { font-size:11px; color:var(--text-dim); line-height:1.4; margin-top:2px }
.setting-toggle-group { display:flex; align-items:center; gap:10px }
.setting-status { font-size:11px; font-weight:500; min-width:55px; text-align:right }
.setting-status.on { color:var(--green) }
.setting-status.off { color:var(--text-dim) }

/* ── CSS Switch Toggle ── */
.switch {
  width: 36px; height: 20px; border-radius: 10px; background: var(--border);
  position: relative; cursor: pointer; transition: background 0.2s; border: none;
  flex-shrink: 0;
}
.switch::after {
  content: ''; width: 16px; height: 16px; border-radius: 50%; background: #fff;
  position: absolute; top: 2px; left: 2px; transition: transform 0.2s;
}
.switch.on { background: var(--green); }
.switch.on::after { transform: translateX(16px); }

/* ── Dashboard Grid Ratio ── */
.grid--dashboard { grid-template-columns: 2fr 3fr; flex: 1; min-height: 0; }
.grid--dashboard > div { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
.grid--dashboard .card--categories { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.card--categories .card-body { overflow-y: auto; flex: 1; min-height: 0; }
.grid--dashboard .card--controls { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.grid--dashboard .card--controls .card-body { overflow-y: auto; flex: 1; min-height: 0; }

/* Bottom grid (Sessions + Events) — fixed height */
.grid--bottom { grid-template-columns: 2fr 3fr; flex: 0 0 auto; max-height: 200px; }

/* ── Issue #8082: Asset Health Section ── */
.card--asset-health { border-left: 3px solid var(--yellow, #e5c07b); }
.card--asset-health h2 svg { width: 16px; height: 16px; color: var(--yellow, #e5c07b); }
.stale-summary { display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
.stale-badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 12px; border-radius: 12px; font-size: 13px; font-weight: 600;
  background: rgba(229,192,123,0.15); color: var(--yellow, #e5c07b);
}
.stale-badge.stale-badge--ok { background: rgba(152,195,121,0.15); color: var(--green, #98c379); }
.stale-details { flex: 1; min-width: 200px; }
.stale-distribution { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
.stale-distribution .dist-item {
  font-size: 11px; padding: 2px 8px; border-radius: 4px;
  background: var(--bg-card, #21252b); color: var(--text-dim, #5c6370);
}
.stale-samples { font-size: 11px; color: var(--text-dim, #5c6370); max-height: 80px; overflow-y: auto; }
.stale-samples .sample { padding: 1px 0; }
.stale-actions { display: flex; gap: 8px; margin-top: 10px; }
.action-btn--warning { background: rgba(229,192,123,0.2); color: var(--yellow, #e5c07b); border: 1px solid rgba(229,192,123,0.3); }
.action-btn--warning:hover { background: rgba(229,192,123,0.3); }
.action-btn--danger { background: rgba(224,108,117,0.2); color: var(--red, #e06c75); border: 1px solid rgba(224,108,117,0.3); }
.action-btn--danger:hover { background: rgba(224,108,117,0.3); }

/* ── Memory Management (Issue #8371) ── */
.memory-select {
  background: var(--card-bg); color: var(--text); border: 1px solid var(--border);
  border-radius: 6px; padding: 6px 10px; font-size: 13px; min-width: 120px;
}
.memory-select:disabled, .memory-input:disabled { opacity: 0.5; cursor: not-allowed; }
.memory-input {
  background: var(--card-bg); color: var(--text); border: 1px solid var(--border);
  border-radius: 6px; padding: 6px 10px; font-size: 13px; width: 100px; text-align: right;
}
.memory-budget { padding: 8px 0; }
.memory-budget-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-dim); margin-bottom: 4px; }
.memory-bar-track { background: var(--border); border-radius: 4px; height: 8px; overflow: hidden; }
.memory-bar-fill { height: 100%; border-radius: 4px; background: var(--accent); transition: width 0.6s ease; }
.memory-bar-fill.warning { background: #e5c07b; }
.memory-bar-fill.danger { background: #e06c75; }
.memory-budget-detail { font-size: 11px; color: var(--text-dim); margin-top: 4px; text-align: right; }
.btn-primary { background: var(--accent); color: #fff; border: none; }
.btn-primary:hover { background: #61afef; }
.btn-primary:disabled { background: var(--border); color: var(--text-dim); cursor: not-allowed; }
.btn-restart { background: #e5c07b; color: #282c34; border: none; margin-left: 6px; }
.btn-restart:hover { background: #d19a66; }

/* ── Info banners (Issue #8470) ── */
.info-banner {
  font-size: 11px;
  line-height: 1.5;
  padding: 6px 10px;
  border-radius: 3px;
  margin-bottom: 8px;
}
.info-banner--warn {
  background: rgba(229, 192, 123, 0.15);
  border: 1px solid rgba(229, 192, 123, 0.4);
  color: var(--yellow, #e5c07b);
}
.info-banner--dim {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  color: var(--text-dim);
}

/* ── Clickable paths (Issue #8470) ── */
.clickable-path {
  cursor: pointer;
  text-decoration: underline dotted;
  text-underline-offset: 2px;
}
.clickable-path:hover { color: var(--accent); }

/* ── AI Client Install/Uninstall buttons (Issue #8528) ── */
.btn-install {
  background: var(--green, #98c379);
  color: #000;
  border: none;
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 3px;
  cursor: pointer;
  font-weight: 500;
}
.btn-install:hover { opacity: 0.85; }
.btn-uninstall {
  background: var(--border, #3a3a3a);
  color: var(--text-dim, #888);
  border: 1px solid var(--border-light, #555);
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 3px;
  cursor: pointer;
  font-weight: 500;
}
.btn-uninstall:hover { background: var(--red, #e06c75); color: #fff; border-color: var(--red, #e06c75); }

/* ── Advanced Settings collapsible (Issue #8470) ── */
.advanced-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 10px;
  background: var(--bg-header);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  margin-bottom: 0;
  transition: border-color 0.2s;
}
.advanced-toggle:hover { border-color: var(--border-light); }
.advanced-toggle .arrow {
  transition: transform 0.2s;
  font-size: 10px;
  color: var(--text-dim);
}
.advanced-toggle.open .arrow { transform: rotate(90deg); }
.advanced-toggle .title {
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text);
}
.advanced-summary {
  margin-left: auto;
  font-size: 11px;
  color: var(--text-dim);
  font-family: var(--font);
}
.advanced-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}
.advanced-content.open {
  max-height: 1000px;
}

/* ── RTL Support (Issue #8660) ── */
[dir="rtl"] { direction: rtl; text-align: right; }
[dir="rtl"] .header-right,
[dir="rtl"] .advanced-summary { margin-left: 0; margin-right: auto; }
[dir="rtl"] .header-left { margin-right: 0; margin-left: auto; }
[dir="rtl"] .status-item svg { margin-right: 0; margin-left: 6px; }
[dir="rtl"] .card-header { flex-direction: row-reverse; }
[dir="rtl"] .progress-label { text-align: left; }
[dir="rtl"] .toast { left: 24px; right: auto; }

/* ── Responsive ── */
@media (max-width: 700px) {
  .grid { grid-template-columns: 1fr; }
  .search-controls { flex-direction: column; }
  .search-controls select { flex: 1; }
  .status-bar { flex-wrap: wrap; }
  .header-lang-select { display: none; }
  .header-right svg:has(+ .header-lang-select) { display: none; }
}

/* ── Configuration Error Banner (Issue #10769 PR 4) ── */
/*
 * Surfaces daemon startup-validation problems above the main UI when the
 * daemon is in degraded mode. Backend gates visibility via
 * status.degraded_mode (see dashboard_api::StatusResponse).
 */
.config-error-banner {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  margin: 12px 24px;
  padding: 16px 20px;
  background: #5a1a1a;
  border-left: 4px solid #d4423d;
  border-radius: 4px;
  color: #ffd6d6;
}
.config-error-banner__icon {
  flex: 0 0 32px;
  font-size: 28px;
  line-height: 1;
  color: #ff8b8b;
}
.config-error-banner__content {
  flex: 1 1 auto;
  min-width: 0;
}
.config-error-banner__title {
  margin: 0 0 4px 0;
  font-size: 16px;
  font-weight: 600;
  color: #ffb3b3;
}
.config-error-banner__subtitle {
  margin: 0 0 12px 0;
  font-size: 13px;
  color: #f0c0c0;
}
.config-error-banner__list {
  margin: 0 0 12px 0;
  padding-left: 18px;
  list-style: disc outside;
  font-size: 13px;
  line-height: 1.5;
}
.config-error-banner__list li + li { margin-top: 4px; }
.config-error-banner__code {
  font-family: var(--font-mono, ui-monospace, "Cascadia Code", Menlo, monospace);
  font-size: 12px;
  background: rgba(0, 0, 0, 0.35);
  padding: 1px 6px;
  border-radius: 3px;
  color: #ffe0e0;
}
.config-error-banner__path {
  color: #ffb3b3;
  font-style: italic;
  word-break: break-all;
}
.config-error-banner__actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.config-error-banner__btn {
  background: #d4423d;
  color: #fff;
  border: none;
  padding: 6px 14px;
  border-radius: 4px;
  cursor: pointer;
  font-family: var(--font);
  font-size: 13px;
  transition: background 120ms ease;
}
.config-error-banner__btn:hover { background: #e8534e; }
.config-error-banner__btn--ghost {
  background: transparent;
  border: 1px solid #d4423d;
  color: #ffb3b3;
}
.config-error-banner__btn--ghost:hover {
  background: rgba(212, 66, 61, 0.18);
}
.config-error-banner__btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/*
 * Inline result line populated by openInClaudeCode() in dashboard.js.
 * Sits directly under .config-error-banner__actions so the launch
 * outcome stays visible next to the button that triggered it, instead
 * of using a toast that the operator might miss.
 */
.config-error-banner__inline-result {
  margin-top: 10px;
  font-size: 12px;
  font-family: var(--font-mono, monospace);
  color: var(--text-dim, #9aa0a6);
  word-break: break-all;
}
.config-error-banner__inline-result--ok {
  color: #5fd07a;
}
.config-error-banner__inline-result--err {
  color: #ff8b8b;
}

/* When the daemon is degraded, dim the chips that no longer reflect
 * meaningful state (memory/CPU still real; sessions/indexing irrelevant).
 * Banner stays at full saturation. */
body.degraded .status-chip { opacity: 0.5; }
body.degraded .config-error-banner,
body.degraded .config-error-banner * { opacity: 1; }

[dir="rtl"] .config-error-banner { border-left: 0; border-right: 4px solid #d4423d; }
[dir="rtl"] .config-error-banner__list { padding-left: 0; padding-right: 18px; }

/* Issue #11147: recovery candidate suggestions block. Lives between the
 * error list and the action buttons. Each row is [source-badge][path]
 * [optional note][Apply button]. Unverified rows are dimmed so the
 * operator can prioritize verified hits. */
.recovery-suggestions {
  margin-top: 10px;
  padding: 8px 12px;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 4px;
}
.recovery-suggestions__header {
  margin: 0 0 6px;
  font-size: 12px;
  color: #ffd9d9;
  font-weight: 500;
}
.recovery-suggestions__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.recovery-suggestions__item {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  font-size: 12px;
}
.recovery-suggestions__item--unverified { opacity: 0.55; }
.recovery-suggestions__badge {
  background: rgba(255, 255, 255, 0.12);
  color: #ffd9d9;
  padding: 1px 6px;
  border-radius: 3px;
  font-size: 11px;
  font-family: var(--font-mono, monospace);
  text-transform: lowercase;
}
.recovery-suggestions__path {
  color: #fff;
  font-family: var(--font-mono, monospace);
  background: transparent;
  word-break: break-all;
}
.recovery-suggestions__note {
  color: #ffb3b3;
  font-size: 11px;
  font-style: italic;
}
.recovery-suggestions__apply {
  margin-left: auto;
  background: transparent;
  color: #ffd9d9;
  border: 1px solid rgba(255, 217, 217, 0.5);
  padding: 2px 8px;
  border-radius: 3px;
  cursor: pointer;
  font-family: var(--font);
  font-size: 11px;
  transition: background 120ms ease;
}
.recovery-suggestions__apply:hover {
  background: rgba(255, 217, 217, 0.12);
}
