function setEngineSourceMode(value) {
  const scanEnabled = value !== 'disabled';
  // The #9383 cost guard only requires confirm on an OFF→ON scan transition
  // (backend checks !current_scan). Mirror that here so an already-scan-on mode
  // switch (e.g. extended→full) doesn't show a misleading "this enables scan"
  // warning. Unknown state (no heartbeat yet) → prompt, to stay safe.
  const scanAlreadyOn = !!(lastEngineConfig && lastEngineConfig.engine_source_scan === true);

  // Issue #15997: enabling engine source scan trips the #9383 cost guard
  // (~46 GB peak RAM / ~5 min rebuild), which rejects the change unless
  // confirm=true is sent. Without a confirm flow the dashboard only showed a
  // cryptic cost-error toast and the SSE heartbeat snapped the dropdown back to
  // the live value after the 5s cooldown — so non-disabled modes never stuck.
  // Surface the cost (mirrors the memory-transition confirm) and send
  // confirm:true on accept; revert the <select> cleanly on cancel.
  if (scanEnabled && !scanAlreadyOn && !confirm(t('settings.engine_source_confirm', value))) {
    const modeSelect = document.getElementById('engine-source-mode');
    // Revert to the last known server mode; fall back to 'disabled' (the DOM /
    // server default, and the safe no-cost choice) when no heartbeat has run yet.
    const revertTo = (lastEngineConfig && lastEngineConfig.engine_source_mode) || 'disabled';
    if (modeSelect) modeSelect.value = revertTo;
    return;
  }

  markConfigChanged();
  runAction('ue_cache_control', 'set_engine_config', {
    engine_source_mode: value,
    engine_source_scan: scanEnabled,
    confirm: scanEnabled
  });
  showToast('info', scanEnabled
    ? t('toast.engine_source_on', value)
    : t('toast.engine_source_off'));

  // Issue #8866: Immediately update PDB status colors without waiting for heartbeat.
  // Derive load flags from the new mode (mirrors PdbLoadConfig::with_engine_source_mode).
  const modeFlags = {
    'disabled': { core: false, runtime: false, editor: false, plugins: false, pdb: false, meta: false },
    'core':     { core: true,  runtime: false, editor: false, plugins: false, pdb: true,  meta: false },
    'extended': { core: true,  runtime: true,  editor: false, plugins: false, pdb: true,  meta: false },
    'full':     { core: true,  runtime: true,  editor: true,  plugins: true,  pdb: true,  meta: true  },
  };
  const flags = modeFlags[value];
  if (flags && lastEngineConfig) {
    lastEngineConfig.load_engine_core = flags.core;
    lastEngineConfig.load_engine_runtime = flags.runtime;
    lastEngineConfig.load_engine_editor = flags.editor;
    lastEngineConfig.load_engine_plugins = flags.plugins;
    lastEngineConfig.include_engine_pdb = flags.pdb;
    lastEngineConfig.include_engine_metadata = flags.meta;
    updateEngineConfig(lastEngineConfig);
  }
}

