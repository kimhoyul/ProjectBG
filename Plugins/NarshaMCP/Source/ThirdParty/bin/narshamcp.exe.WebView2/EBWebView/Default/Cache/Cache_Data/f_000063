// ── Utilities ──
function formatUptime(secs) {
  if (secs == null) return '--:--:--';
  const h = Math.floor(secs / 3600);
  const m = Math.floor((secs % 3600) / 60);
  const s = secs % 60;
  return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
}

function formatAge(iso) {
  if (!iso) return '-';
  const time = new Date(iso).getTime();
  if (isNaN(time)) return '-';
  const diff = Math.floor((Date.now() - time) / 1000);
  if (diff < 60) return t('time.seconds_ago', diff);
  if (diff < 3600) return t('time.minutes_ago', Math.floor(diff / 60));
  return t('time.hours_ago', Math.floor(diff / 3600));
}

function esc(s) {
  if (!s) return '';
  const el = document.createElement('span');
  el.textContent = s;
  return el.innerHTML;
}

function showToast(type, message) {
  const container = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = 'toast toast-' + type;
  toast.textContent = message;
  container.appendChild(toast);
  setTimeout(() => toast.remove(), 4000);
}

// ── Initial Load (with retry for slow daemon startup) ──
async function loadInitialState(attempt) {
  attempt = attempt || 1;
  const maxAttempts = 30; // 30 x 2s = 60s max wait
  try {
    const [statusRes, sessionsRes, progressRes] = await Promise.all([
      fetch('/api/daemon/status'),
      fetch('/api/daemon/sessions'),
      fetch('/api/daemon/progress'),
    ]);
    const status = await statusRes.json();
    const sessions = await sessionsRes.json();
    const progress = await progressRes.json();
    updateOverview({ status, sessions: sessions.sessions, progress });
    document.getElementById('connection-status').textContent = t('header.connected');
    document.getElementById('connection-status').className = 'badge badge-green';
    loadAiClients(); // Issue #8288: Load AI client config status
  } catch (err) {
    console.warn('Initial load attempt ' + attempt + ' failed:', err.message);
    document.getElementById('connection-status').textContent = t('header.connecting', attempt);
    document.getElementById('connection-status').className = 'badge badge-red';
    if (attempt < maxAttempts) {
      setTimeout(() => loadInitialState(attempt + 1), 2000);
    }
  }
}

