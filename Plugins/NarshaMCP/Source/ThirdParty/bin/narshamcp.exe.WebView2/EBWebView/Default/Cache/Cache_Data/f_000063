/**
 * Format an ISO 8601 timestamp into "YYYY-MM-DD" for compact display.
 */
function _edFormatDate(iso) {
  if (!iso || iso === 'unknown') return '—';
  try {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  } catch (e) {
    return iso;
  }
}

/**
 * Render the Engine Docs status card from the SSE heartbeat payload.
 */
function updateEngineDocs(ed) {
  const statusEl = document.getElementById('engine-docs-status');
  const badgeEl = document.getElementById('engine-docs-state-badge');
  const btn = document.getElementById('rehydrate-btn');
  const progress = document.getElementById('engine-docs-progress');
  const bar = document.getElementById('engine-docs-progress-bar');
  const progressText = document.getElementById('engine-docs-progress-text');
  const hint = document.getElementById('engine-docs-hint');
  if (!statusEl || !btn) return;

  const enginePathOK = ed.engine_path_available === true;
  const sizeStr = ed.file_size_mb != null ? `${ed.file_size_mb.toFixed(1)} MB` : '—';
  const dateStr = _edFormatDate(ed.last_modified);

  // Helper: set the small "state badge" pill in the toggle group.
  // Uses the same .setting-status on/off classes as the file-watcher row
  // so the styling is consistent across the Settings tab.
  function setBadge(label, kind) {
    if (!badgeEl) return;
    badgeEl.textContent = label;
    // Reset class first, then apply the new variant.
    badgeEl.className = 'setting-status ' + kind;
  }

  switch (ed.status) {
    case 'hydrated': {
      statusEl.textContent = t('settings.engine_docs_hydrated', sizeStr, dateStr, ed.documents.toLocaleString());
      statusEl.style.color = 'var(--text)';
      setBadge(t('settings.engine_docs_badge_hydrated'), 'on');
      btn.disabled = !enginePathOK;
      btn.textContent = t('settings.engine_docs_rehydrate');
      progress.style.display = 'none';
      if (hint) {
        if (!enginePathOK) {
          hint.style.display = '';
          hint.textContent = t('settings.engine_docs_config_path_hint');
        } else {
          hint.style.display = 'none';
        }
      }
      break;
    }
    case 'skeleton': {
      statusEl.textContent = t('settings.engine_docs_skeleton', ed.documents.toLocaleString());
      statusEl.style.color = 'var(--yellow)';
      setBadge(t('settings.engine_docs_badge_skeleton'), 'off');
      btn.disabled = !enginePathOK;
      btn.textContent = t('settings.engine_docs_hydrate');
      progress.style.display = 'none';
      if (hint) {
        hint.style.display = '';
        hint.textContent = enginePathOK
          ? t('settings.engine_docs_skeleton_hint')
          : t('settings.engine_docs_config_first_hint');
      }
      break;
    }
    case 'hydrating': {
      const total = ed.progress_total || 0;
      const done = ed.progress_done || 0;
      const pct = total > 0 ? Math.min(100, Math.round((done / total) * 100)) : 0;
      statusEl.textContent = t('settings.engine_docs_hydrating_status', done.toLocaleString(), total.toLocaleString());
      statusEl.style.color = 'var(--cyan)';
      setBadge(t('settings.engine_docs_badge_hydrating'), 'on');
      btn.disabled = true;
      btn.textContent = t('settings.engine_docs_hydrating');
      progress.style.display = '';
      bar.style.width = pct + '%';
      progressText.textContent = pct + '%';
      if (hint) hint.style.display = 'none';
      break;
    }
    case 'not_loaded':
    default: {
      statusEl.textContent = t('settings.engine_docs_not_loaded');
      statusEl.style.color = 'var(--text-dim)';
      setBadge(t('settings.engine_docs_badge_not_loaded'), 'off');
      btn.disabled = true;
      btn.textContent = t('settings.engine_docs_rehydrate');
      progress.style.display = 'none';
      if (hint) {
        hint.style.display = '';
        hint.textContent = t('settings.engine_docs_install_hint');
      }
      break;
    }
  }
}

/**
 * Trigger a manual re-hydration via POST /api/daemon/rehydrate.
 * The actual progress is tracked via the SSE heartbeat, so this function
 * only handles the POST acknowledgement and the error UI.
 */
function triggerRehydrate() {
  const btn = document.getElementById('rehydrate-btn');
  const hint = document.getElementById('engine-docs-hint');
  if (!btn) return;
  btn.disabled = true;
  btn.textContent = t('settings.engine_docs_starting');

  fetch('/api/daemon/rehydrate', { method: 'POST' })
    .then(r => r.json().then(body => ({ status: r.status, body })))
    .then(({ status, body }) => {
      if (status === 202) {
        // Success — SSE heartbeat will flip card to "Hydrating..." on next tick.
        if (hint) hint.style.display = 'none';
        return;
      }
      // Non-202: restore button and show message.
      btn.disabled = false;
      btn.textContent = t('settings.engine_docs_rehydrate');
      if (hint) {
        hint.style.display = '';
        hint.textContent = (body && body.message) || t('settings.engine_docs_rehydration_failed', status);
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.textContent = t('settings.engine_docs_rehydrate');
      if (hint) {
        hint.style.display = '';
        hint.textContent = t('settings.engine_docs_network_error');
      }
      console.error('triggerRehydrate failed:', err);
    });
}

// ── Language Selector ──
function populateLanguageSelector() {
  var langs = I18N.getLangs();
  ['language-select', 'header-lang-select'].forEach(function(id) {
    var sel = document.getElementById(id);
    if (!sel) return;
    sel.innerHTML = '';
    langs.forEach(function(l) {
      var opt = document.createElement('option');
      opt.value = l.code;
      opt.textContent = l.name;
      if (l.code === I18N._lang) opt.selected = true;
      sel.appendChild(opt);
    });
  });
}

// ── Memory Guard (Issue #12148) ──
// Polled every 10s — guard sampling itself fires every mi_collect tick
// (default 300s), so faster polling here only smooths the UI rather than
// providing genuinely fresher data. 10s matches the existing /memory-status
// cadence and keeps the badge responsive when a transition crosses a
// dashboard refresh.
var _memoryGuardLastLevel = 'NORMAL';
var _memoryGuardBackoffMs = 10000;

function levelColor(level) {
  return level === 'HARD_CAP' ? 'var(--red)'
    : level === 'CRITICAL' ? 'var(--orange, #d97706)'
    : level === 'WARN' ? 'var(--yellow, #ca8a04)'
    : 'var(--green)';
}

function loadMemoryGuard() {
  fetch('/api/daemon/memory-guard').then(function (r) { return r.json(); })
    .then(function (data) {
      var section = document.getElementById('memory-guard-section');
      var badge = document.getElementById('memory-guard-badge');
      if (!section || !badge) return;
      var color = levelColor(data.level);
      section.style.borderLeftColor = color;
      badge.textContent = data.level;
      badge.style.color = color;
      badge.style.background = data.level === 'NORMAL' ? 'var(--bg-dim)' : 'rgba(0,0,0,0.15)';
      var setText = function (id, v) { var el = document.getElementById(id); if (el) el.textContent = v; };
      setText('memory-guard-rss', data.rss_mb || 0);
      setText('memory-guard-cap', data.hard_cap_mb || 0);
      setText('memory-guard-warn', data.warn_mb || 0);
      setText('memory-guard-critical', data.critical_mb || 0);
      setText('memory-guard-rejected', data.rejected_count || 0);
      var msg = document.getElementById('memory-guard-message');
      if (msg) msg.textContent = data.message || '';
      // Transitions log: render newest-first, last 10 entries.
      var tx = document.getElementById('memory-guard-transitions');
      if (tx && Array.isArray(data.transitions)) {
        var rows = data.transitions.slice(-10).reverse().map(function (e) {
          var when = new Date(e.ts_ms).toLocaleTimeString();
          return when + '  ' + e.from + ' → ' + e.to + '  (' + e.rss_mb + ' MB)';
        });
        tx.textContent = rows.join('\n');
      }
      // Surface a toast on transition into WARN or worse so headless users
      // see the level change even when they aren't looking at the tab.
      if (data.level !== _memoryGuardLastLevel) {
        if (data.level === 'CRITICAL' || data.level === 'HARD_CAP') {
          if (typeof showToast === 'function') {
            showToast('error', data.message || ('Memory guard: ' + data.level));
          }
        } else if (data.level === 'WARN' && _memoryGuardLastLevel === 'NORMAL') {
          if (typeof showToast === 'function') {
            showToast('warn', data.message || 'Memory guard: WARN');
          }
        }
        _memoryGuardLastLevel = data.level;
      }
    })
    .catch(function () { /* daemon may be restarting; next tick retries */ });
}

// ── Startup ──
function startDashboard() {
  populateLanguageSelector();
  loadInitialState(1);
  connectSSE();
  loadMemoryStatus();
  loadMemoryGuard();
  setInterval(loadMemoryGuard, _memoryGuardBackoffMs);
  fetch('/api/daemon/telemetry').then(r => r.json()).then(updateTelemetry).catch(() => {});
}

fetch('/dashboard/i18n.json')
  .then(function(r) { return r.json(); })
  .then(function(data) { I18N.init(data); startDashboard(); })
  .catch(function() { startDashboard(); });
