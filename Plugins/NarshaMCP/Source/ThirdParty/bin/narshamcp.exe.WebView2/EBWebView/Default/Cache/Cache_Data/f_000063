// escapeHtml aliases esc() for readability in AI client rendering
function escapeHtml(s) { return esc(s); }

function renderAiClientRow(client) {
  var row = document.createElement('div');
  row.className = 'setting-row';
  var isLocal = client.scope === 'project_local';
  var isEnabled = client.status === 'enabled';
  var statusLabels = { enabled: t('settings.ai_installed'), disabled: t('settings.ai_not_installed'), global_only: t('settings.ai_global_only') };
  var statusText = statusLabels[client.status] || client.status;
  var toggleHtml;
  if (isLocal) {
    var btnLabel = isEnabled ? t('settings.ai_uninstall') : t('settings.ai_install');
    toggleHtml = '<div class="setting-toggle-group">' +
      '<span class="setting-status ' + (isEnabled ? 'on' : 'off') + '">' + escapeHtml(statusText) + '</span>' +
      '<button class="action-btn ' + (isEnabled ? 'btn-uninstall' : 'btn-install') + '" onclick="toggleAiClient(\'' + client.id + '\', ' + !isEnabled + ')">' + btnLabel + '</button>' +
      '</div>';
  } else {
    toggleHtml = '<div class="setting-toggle-group">' +
      '<span class="setting-status off" style="font-size:11px">' + escapeHtml(client.note || t('settings.ai_global_only')) + '</span>' +
      '</div>';
  }
  var experimentalBadge = client.experimental
    ? ' <span style="font-size:9px;padding:1px 5px;border-radius:3px;background:var(--yellow,#b58900);color:#000;margin-left:6px;vertical-align:middle">' + esc(t('settings.ai_experimental')) + '</span>'
    : '';
  var pathInfo = client.config_path
    ? '<div class="setting-desc" style="font-size:10px;opacity:0.6">' + escapeHtml(client.config_path) + '</div>'
    : '';
  var globalWarning = client.global_config_detected
    ? '<div style="font-size:10px;color:var(--yellow,#e5c07b);margin-top:2px">&#9888; ' + escapeHtml(client.global_config_hint || t('settings.ai_global_hint')) + '</div>'
    : '';
  row.innerHTML = '<div><div class="setting-label">' + escapeHtml(client.name) + experimentalBadge + '</div>' + pathInfo + globalWarning + '</div>' + toggleHtml;
  return row;
}

function renderAiClients(clients) {
  const container = document.getElementById('ai-clients-list');
  if (!container) return;
  container.innerHTML = '';

  // Issue #8470: Separate primary client (Claude Code) from others
  var primary = [];
  var others = [];
  clients.forEach(function(client) {
    if (client.id === 'claude_code') {
      primary.push(client);
    } else {
      others.push(client);
    }
  });

  // Always-visible: Claude Code
  primary.forEach(function(client) {
    container.appendChild(renderAiClientRow(client));
  });

  // Collapsible: all other clients
  if (others.length > 0) {
    var enabledCount = others.filter(function(c) { return c.status === 'enabled'; }).length;
    var summaryText = enabledCount > 0
      ? t('settings.ai_clients_count', enabledCount, others.length)
      : t('settings.ai_clients_label', others.length);

    var toggle = document.createElement('div');
    toggle.className = 'advanced-toggle' + (localStorage.getItem('aiClientsExpanded') === '1' ? ' open' : '');
    toggle.onclick = function() { toggleAiClientsExpanded(); };
    toggle.innerHTML = '<span class="arrow">&#9654;</span>' +
      '<span class="title">' + esc(t('settings.ai_other_clients')) + '</span>' +
      '<span class="advanced-summary" id="advanced-summary">' + escapeHtml(summaryText) + '</span>';
    container.appendChild(toggle);

    var content = document.createElement('div');
    content.id = 'advanced-settings-content';
    content.className = 'advanced-content' + (localStorage.getItem('aiClientsExpanded') === '1' ? ' open' : '');
    others.forEach(function(client) {
      content.appendChild(renderAiClientRow(client));
    });
    container.appendChild(content);
  }
}

async function toggleAiClient(clientId, enabled) {
  try {
