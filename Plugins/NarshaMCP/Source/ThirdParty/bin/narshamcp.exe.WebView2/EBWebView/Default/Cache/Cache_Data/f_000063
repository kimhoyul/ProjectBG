// ── Memory Breakdown (Issue #8040) ──
async function showMemoryBreakdown() {
  const modal = document.getElementById('memory-modal');
  const content = document.getElementById('memory-breakdown-content');
  content.innerHTML = '<div style="color:var(--text-dim)">' + esc(t('modal.loading_breakdown')) + '</div>';
  modal.classList.add('visible');

  try {
    const resp = await fetch('/api/daemon/memory-breakdown');
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const data = await resp.json();
    renderMemoryBreakdown(content, data);
  } catch (err) {
    content.innerHTML = '<div style="color:var(--red)">' + esc(t('toast.action_failed')) + ': ' + esc(String(err.message || err)) + '</div>';
  }
}

function renderMemoryBreakdown(container, data) {
  const cats = (data.categories || []).slice().sort((a, b) => b.mb - a.mb);

  let html = '<div style="margin-bottom:12px">';
  html += '<div style="display:flex;justify-content:space-between;margin-bottom:4px">'
    + '<span style="color:var(--text-dim)">' + esc(t('modal.rss')) + '</span>'
    + '<span style="color:var(--green);font-weight:600">' + formatMemMB(data.rss_mb) + '</span></div>';
  html += '<div style="display:flex;justify-content:space-between;margin-bottom:4px">'
    + '<span style="color:var(--text-dim)">' + esc(t('modal.private')) + '</span>'
    + '<span style="color:var(--cyan);font-weight:600">' + formatMemMB(data.private_mb) + '</span></div>';
  html += '<div style="display:flex;justify-content:space-between;margin-bottom:4px">'
    + '<span style="color:var(--text-dim)">' + esc(t('modal.measured_total')) + '</span>'
    + '<span style="color:var(--text-bright);font-weight:600">' + formatMemMB(data.total_measured_mb) + '</span></div>';
  html += '</div>';

  html += '<div style="border-top:1px solid var(--border-light);padding-top:8px">';
  cats.forEach(function(c) {
    if (c.mb < 0.1) return;
    var barPct = data.rss_mb > 0 ? Math.min(100, (c.mb / data.rss_mb) * 100) : 0;
    var estMark = c.is_estimate ? ' <span style="color:var(--text-dim);font-size:10px">~est</span>' : '';
    var countStr = c.entry_count != null ? ' <span style="color:var(--text-dim);font-size:10px">(' + c.entry_count.toLocaleString() + ')</span>' : '';
    html += '<div style="margin-bottom:6px">'
      + '<div style="display:flex;justify-content:space-between;font-size:12px">'
      + '<span>' + esc(c.name) + countStr + estMark + '</span>'
      + '<span style="color:var(--text-bright)">' + formatMemMB(c.mb) + '</span></div>'
      + '<div class="progress-bar" style="height:4px"><div class="progress-fill cyan" style="width:' + barPct.toFixed(1) + '%"></div></div>'
      + '</div>';
  });

  if (data.gap_mb > 0) {
    html += '<div style="margin-top:8px;display:flex;justify-content:space-between;font-size:11px;color:var(--text-dim)">'
      + '<span>' + esc(t('modal.unmeasured')) + '</span>'
      + '<span>' + formatMemMB(data.gap_mb) + '</span></div>';
  }
  html += '</div>';

  container.innerHTML = html;
}

function formatMemMB(mb) {
  if (mb >= 1024) return (mb / 1024).toFixed(1) + ' GB';
  if (mb >= 100) return mb.toFixed(0) + ' MB';
  if (mb >= 1) return mb.toFixed(1) + ' MB';
  if (mb >= 0.001) return (mb * 1024).toFixed(0) + ' KB';
  return '0 KB';
}

function closeMemoryModal() {
  document.getElementById('memory-modal').classList.remove('visible');
}

// ── Memory Management (Issue #8371) ──
let memoryStatusLoaded = false;

function loadMemoryStatus() {
  fetch('/api/daemon/memory-status')
    .then(r => r.json())
    .then(data => {
      memoryStatusLoaded = true;
      renderMemoryPanel(data);
    })
    .catch(err => console.warn('memory-status fetch failed:', err));
}

function renderMemoryPanel(data) {
  const sel = document.getElementById('memory-mode-select');
  const inp = document.getElementById('memory-limit-input');
  const limitRow = document.getElementById('memory-limit-row');
  const budgetBar = document.getElementById('memory-budget-bar');
  const btn = document.getElementById('memory-apply-btn');
  const desc = document.getElementById('memory-mode-desc');

  if (!sel || !inp) return;

  // 'auto' resolves to 'bounded' or 'unbounded' at startup; the dropdown
  // only offers those two concrete modes. Coerce 'auto' to the resolved
  // value so the select doesn't silently become empty.
  const rawMode = data.memory_mode || 'unbounded';
  const mode = (rawMode === 'auto') ? (data.is_bounded ? 'bounded' : 'unbounded') : rawMode;
  sel.value = mode;
  sel.disabled = false;
  inp.value = data.limit_mb || 4096;
  inp.disabled = false;
  btn.disabled = false;

  desc.textContent = mode === 'bounded'
    ? t('settings.memory_bounded_desc')
    : t('settings.memory_unbounded_desc');

  // Show limit row + budget bar only in bounded mode
  const isBounded = mode === 'bounded';
  limitRow.style.display = isBounded ? 'flex' : 'none';
  budgetBar.style.display = isBounded ? 'block' : 'none';

  if (isBounded && data.budget) {
    const warmMB = (data.budget.current_warm_bytes / (1024 * 1024)).toFixed(0);
    const budgetMB = (data.budget.warm_budget_bytes / (1024 * 1024)).toFixed(0);
    const pct = data.budget.utilization_pct || 0;
    document.getElementById('memory-budget-pct').textContent = pct.toFixed(1) + '%';
    document.getElementById('memory-budget-detail').textContent = warmMB + ' / ' + budgetMB + ' MB';
    const fill = document.getElementById('memory-bar-fill');
    fill.style.width = Math.min(pct, 100) + '%';
    fill.className = 'memory-bar-fill' + (pct > 90 ? ' danger' : pct > 70 ? ' warning' : '');
  }

  // Disable controls during transition
  if (data.transition && data.transition.state === 'running') {
    sel.disabled = true;
    inp.disabled = true;
    btn.disabled = true;
    btn.textContent = t('settings.memory_transitioning');
  } else {
    btn.textContent = t('settings.memory_apply');
  }

  // Enable Apply only when values differ from current
  sel.onchange = inp.oninput = () => onMemoryFormChange(data);
}

function onMemoryFormChange(currentData) {
  const sel = document.getElementById('memory-mode-select');
  const inp = document.getElementById('memory-limit-input');
  const btn = document.getElementById('memory-apply-btn');
  const limitRow = document.getElementById('memory-limit-row');
  const budgetBar = document.getElementById('memory-budget-bar');

  const isBounded = sel.value === 'bounded';
  limitRow.style.display = isBounded ? 'flex' : 'none';
  budgetBar.style.display = (isBounded && currentData.memory_mode === 'bounded') ? 'block' : 'none';

  const modeChanged = sel.value !== currentData.memory_mode;
  const limitChanged = isBounded && parseInt(inp.value) !== currentData.limit_mb;
  btn.disabled = !(modeChanged || limitChanged);
}

function applyMemoryTransition() {
  const mode = document.getElementById('memory-mode-select').value;
  const limit = parseInt(document.getElementById('memory-limit-input').value);
  const btn = document.getElementById('memory-apply-btn');

  const msg = mode === 'bounded'
    ? t('settings.memory_confirm_bounded', limit)
    : t('settings.memory_confirm_unbounded');

  if (!confirm(msg)) return;

  btn.disabled = true;
  btn.textContent = t('settings.memory_applying');
  showMemoryProgressOverlay();

  const params = { memory_mode: mode };
  if (mode === 'bounded') params.memory_limit_mb = limit;

  fetch('/api/daemon/action', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ tool: 'ue_cache_control', operation: 'set_engine_config', params: params })
  })
  .then(r => r.json())
  .then(data => {
    if (!data.success) {
      hideMemoryProgressOverlay();
      alert(t('error.transition_failed', data.error || 'unknown'));
    }
    // On success, the SSE events handle progress + completion
    loadMemoryStatus();
  })
  .catch(err => {
    hideMemoryProgressOverlay();
    alert(t('error.transition_request_failed', err));
  })
  .finally(() => {
    btn.textContent = t('settings.memory_apply');
  });
}

function handleMemoryTransitionEvent(type, data) {
  const overlay = document.getElementById('memory-progress-overlay');
  const phase = document.getElementById('memory-progress-phase');
  const bar = document.getElementById('memory-progress-bar');
  const pct = document.getElementById('memory-progress-pct');

  switch (type) {
    case 'memory_transition_started':
      showMemoryProgressOverlay();
      phase.textContent = data.from_mode + ' → ' + data.to_mode;
      bar.style.width = '0%';
      pct.textContent = '0%';
      break;
    case 'memory_transition_progress':
      phase.textContent = data.phase;
      bar.style.width = data.progress_pct + '%';
      pct.textContent = data.progress_pct + '%';
      break;
    case 'memory_transition_completed':
      phase.textContent = t('settings.memory_complete', data.total_elapsed_ms);
      bar.style.width = '100%';
      pct.textContent = '100%';
      setTimeout(() => {
        hideMemoryProgressOverlay();
        loadMemoryStatus();
        // Show restart prompt for real RSS savings
        showRestartPrompt();
      }, 1500);
      break;
    case 'memory_transition_failed':
      phase.textContent = t('settings.memory_failed_at', data.phase, data.error);
      bar.style.width = '0%';
      pct.textContent = t('error.generic');
      bar.classList.add('danger');
      setTimeout(hideMemoryProgressOverlay, 3000);
      break;
  }
}

function showMemoryProgressOverlay() {
  document.getElementById('memory-progress-overlay').style.display = 'flex';
}

function hideMemoryProgressOverlay() {
  document.getElementById('memory-progress-overlay').style.display = 'none';
  document.getElementById('memory-progress-bar').classList.remove('danger');
}

function showRestartPrompt() {
  const restartBtn = document.getElementById('memory-restart-btn');
  if (restartBtn) restartBtn.style.display = 'inline-block';
}

// ── Configuration Error Banner (Issue #10769 PR 4) ──
//
// Reads `status.degraded_mode` + `status.config_errors[]` from
// `/api/daemon/status` (and SSE `config_changed` events in PR 6) and
// shows/hides the #config-error-banner. The banner stays in the DOM but
// `display:none` when healthy, so it can flicker on/off as the user fixes
// .env without page reload.
function applyDegradedBanner(status) {
  const banner = document.getElementById('config-error-banner');
  if (!banner) return; // Defensive: pre-PR-4 dashboards lack the element.

  const isDegraded = !!(status && status.degraded_mode);
  if (!isDegraded) {
    banner.style.display = 'none';
    document.body.classList.remove('degraded');
    // Issue #11147: clear recovery suggestions when daemon recovers so a
    // stale list doesn't linger if the banner re-shows for a different
    // error class.
    const sugHost = document.getElementById('recovery-suggestions');
    if (sugHost) {
      sugHost.hidden = true;
      sugHost.innerHTML = '';
    }
    return;
  }

  // Populate one <li> per reason. The fix_instruction_key is resolved
  // through I18N.t() so the message follows the user's language selection.
  // Path is shown verbatim — it's a user-supplied string, never localized.
  const list = document.getElementById('config-error-list');
  if (list) {
    list.innerHTML = '';
    const errors = status.config_errors || [];
    errors.forEach(err => {
      const li = document.createElement('li');
      const codeSpan = document.createElement('code');
      codeSpan.className = 'config-error-banner__code';
      codeSpan.textContent = err.code;
      li.appendChild(codeSpan);
      li.appendChild(document.createTextNode(' '));
      // Issue #10769 PR 8: pass `extra` (variant-specific values like
      // EngineVersionMismatch's [assoc, uproject_engine, env_engine]) into
      // I18N.t so parameterized strings ("expects {0} ({1}); .env points
      // at {2}") substitute correctly. For non-parameterized variants the
      // extra Vec is empty and t() ignores trailing args.
      const fixSpan = document.createElement('span');
      const extraArgs = Array.isArray(err.extra) ? err.extra : [];
      fixSpan.textContent = t.apply(null, [err.fix_instruction_key].concat(extraArgs));
      li.appendChild(fixSpan);
      // Issue #10769 PR 8: severity badge (warning vs. error) so the
      // banner can de-emphasize informational items like
      // EngineVersionMismatch (daemon CAN run, just with stale engine).
      if (err.severity === 'warning') {
        li.classList.add('config-error-banner__item--warning');
      }
      // PR 8: only show the user_path suffix when extra is empty —
      // parameterized fix strings already include the relevant paths
      // inline ("...points at {2}"), so appending user_path again would
      // duplicate them.
      if (err.user_path && extraArgs.length === 0) {
        const pathSpan = document.createElement('span');
        pathSpan.className = 'config-error-banner__path';
        pathSpan.textContent = ' (' + err.user_path + ')';
        li.appendChild(pathSpan);
      }
      list.appendChild(li);
    });
  }

  // Issue #11147: aggregate suggested_paths across all errors and render
  // the unified "Try one of these detected paths:" section. Suggestions
  // are deduplicated by absolute path so duplicate hits across env/.ini
  // /.uproject collapse to one row.
  renderRecoverySuggestions(status.config_errors || []);

  banner.style.display = '';
  // body.degraded lets CSS dim the now-meaningless backend chips
  // (indexing/sessions/memory) so the banner is the visual focus.
  document.body.classList.add('degraded');
}

// Issue #11147: render per-error recovery candidates from the engine
// resolve chain (env / config.ini / .uproject / install scan). Each row
// shows [source-badge] [path] [Apply] where Apply copies the platform-
// specific env-set command to the clipboard.
function renderRecoverySuggestions(errors) {
  const host = document.getElementById('recovery-suggestions');
  if (!host) return; // Pre-#11147 dashboard.

  // Flatten + dedupe by path. Preserve first-occurrence ordering so the
  // priority chain (env first, scan last) shows through visually.
  const seen = new Set();
  const flat = [];
  errors.forEach(err => {
    (err.suggested_paths || []).forEach(c => {
      if (!seen.has(c.path)) {
        seen.add(c.path);
        // Issue #11147 review C-1: detect project-class reasons by 'PROJECT' substring.
        // Both MISSING_PROJECT_PATH and PROJECT_PATH_NOT_* must route to UECODEGEN_PROJECT_DIR.
        // startsWith('PROJECT_') would have missed MISSING_PROJECT_PATH and copied the wrong env var.
        flat.push({ candidate: c, varName: err.code && err.code.includes('PROJECT') ? 'UECODEGEN_PROJECT_DIR' : 'UECODEGEN_ENGINE_DIR' });
      }
    });
  });

  if (flat.length === 0) {
    host.hidden = true;
    host.innerHTML = '';
    return;
  }

  host.hidden = false;
  host.innerHTML = '';
  const header = document.createElement('p');
  header.className = 'recovery-suggestions__header';
  header.textContent = t('degraded.recovery_hint.try_paths');
  host.appendChild(header);

  const list = document.createElement('ul');
  list.className = 'recovery-suggestions__list';
  flat.forEach(({ candidate, varName }) => {
    const li = document.createElement('li');
    li.className = 'recovery-suggestions__item';
    if (!candidate.verified) {
      li.classList.add('recovery-suggestions__item--unverified');
    }

    const sourceBadge = document.createElement('span');
    sourceBadge.className = 'recovery-suggestions__badge';
    sourceBadge.textContent = t('recovery_hint.source.' + candidate.source);
    li.appendChild(sourceBadge);

    const pathSpan = document.createElement('code');
    pathSpan.className = 'recovery-suggestions__path';
    pathSpan.textContent = candidate.path;
    li.appendChild(pathSpan);

    if (candidate.note) {
      const noteSpan = document.createElement('span');
      noteSpan.className = 'recovery-suggestions__note';
      noteSpan.textContent = candidate.note;
      li.appendChild(noteSpan);
    }

    const applyBtn = document.createElement('button');
    applyBtn.type = 'button';
    applyBtn.className = 'recovery-suggestions__apply';
    applyBtn.textContent = t('recovery_hint.action.apply');
    applyBtn.addEventListener('click', () => {
      // Platform detection is best-effort — userAgent is the only signal
      // available to the dashboard JS. We emit BOTH the per-shell and the
      // persistent setx form on Windows so the operator's clipboard works
      // whether they paste into cmd, PowerShell, or "permanent" config.
      const isWindows = /Win/i.test(navigator.userAgent || '');
      const cmd = isWindows
        ? `set ${varName}="${candidate.path}"\nsetx ${varName} "${candidate.path}"`
        : `export ${varName}="${candidate.path}"`;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(cmd).then(
          () => showToast('success', t('recovery_hint.action.copied')),
          () => showToast('error', t('degraded.copy_guide.copy_failed'))
        );
      } else {
        // Pre-clipboard-API fallback.
        window.prompt(t('recovery_hint.action.copied'), cmd);
      }
    });
    li.appendChild(applyBtn);

    list.appendChild(li);
  });
  host.appendChild(list);
}

// Copy a plain-text fix guide to clipboard so the user can paste it into
// notes / tickets / .env comments. Pulls the same i18n strings the banner
// renders, so the copy stays in sync with what's on screen.
function copyFixGuide() {
  const list = document.getElementById('config-error-list');
  if (!list) return;

  // Header + current diagnosis from the live banner
  const lines = [t('degraded.title'), ''];
  Array.from(list.children).forEach(li => {
    lines.push('  - ' + (li.textContent || '').trim());
  });
  lines.push('');

  // Issue #10769 follow-up: enumerate ALL configuration sources in priority
  // order. Different deployment paths mean different "correct" places to
  // edit:
  //   - Claude Code MCP user → `.mcp.json` (most common)
  //   - Direct CLI invocation → `narshamcp daemon --project-path X`
  //   - Headless / shell scripts → environment variables
  //   - UE plugin (post-build) → Config/config.ini (auto-populated)
  //   - Repo developer → `.env`
  // Plain text — no I18N here because the option names (file paths, env
  // var names, CLI flag names) are language-neutral.
  lines.push('=== Project path — set via ONE of these (priority order) ===');
  lines.push('  1. .mcp.json (Claude Code MCP config) — args: ["connect", "--project-path", "<DIR>", ...]');
  lines.push('  2. CLI flag — narshamcp daemon --project-path <DIR>');
  lines.push('  3. Environment variable — UECODEGEN_PROJECT_DIR=<DIR>');
  lines.push('  4. Config/config.ini — [Paths] default_project_path = <DIR>');
  lines.push('  5. .env file (dev mode)        — UECODEGEN_PROJECT_DIR=<DIR>');
  lines.push('');
  lines.push('=== Engine path — same priority order ===');
  lines.push('  1. .mcp.json — args: ["connect", "--engine-path", "<UE_ROOT>", ...]');
  lines.push('  2. CLI flag — narshamcp daemon --engine-path <UE_ROOT>');
  lines.push('  3. Environment variable — UECODEGEN_ENGINE_DIR=<UE_ROOT>');
  lines.push('  4. Config/config.ini — [Paths] engine_path = <UE_ROOT>');
  lines.push('  5. .env file (dev mode)        — UECODEGEN_ENGINE_DIR=<UE_ROOT>');
  lines.push('');
  lines.push('Where <DIR> contains a *.uproject file');
  lines.push('Where <UE_ROOT> is the UE install root, e.g. C:/Program Files/Epic Games/UE_5.7');
  lines.push('After updating, click "Restart Daemon" or rerun `claude` to apply.');

  const text = lines.join('\n');
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(
      () => showToast('success', t('degraded.copy_guide.copied')),
      () => showToast('error', t('degraded.copy_guide.copy_failed'))
    );
  } else {
    // Pre-clipboard-API fallback: prompt() lets the user copy manually.
    window.prompt(t('degraded.copy_guide.copied'), text);
  }
}

function restartDaemon() {
  if (!confirm(t('settings.memory_restart_confirm'))) return;
  const btn = document.getElementById('memory-restart-btn');
  if (btn) { btn.disabled = true; btn.textContent = t('header.restarting'); }
  fetch('/api/daemon/restart', { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        document.getElementById('connection-status').textContent = t('header.restarting');
        document.getElementById('connection-status').className = 'badge badge-yellow';
      } else {
        alert(t('toast.restart_failed') + ': ' + (data.error || 'unknown'));
        if (btn) { btn.disabled = false; btn.textContent = t('settings.memory_restart'); }
      }
    })
    .catch(err => {
      // Connection lost = restart in progress (expected)
      document.getElementById('connection-status').textContent = t('header.restarting');
      document.getElementById('connection-status').className = 'badge badge-yellow';
    });
}

/**
 * Collect a single-line human-readable summary of the current degraded
 * banner so we can hand it to the spawned Claude Code session as
 * context. Concatenates each <li> in #config-error-list — the same DOM
 * applyDegradedBanner() populates — separated by `; `. Falls back to a
 * generic message when the banner is empty (degraded flag is on but
 * no structured reasons were attached, which is rare but possible).
 */
function collectDegradedErrorMessage() {
  const list = document.getElementById('config-error-list');
  if (!list || !list.children.length) {
    return 'Daemon reported degraded_mode without structured config_errors';
  }
  return Array.from(list.children)
    .map(li => (li.textContent || '').trim())
    .filter(Boolean)
    .join('; ');
}

/**
 * Shared spawn-and-render helper for any "Open in Claude Code" button.
 *
 * Two call sites exist as of v0.10.x:
 *   1. The degraded-mode config-error banner — `openInClaudeCode()`
 *      collects the structured `config_errors[]` summary.
 *   2. The per-indexing-cycle `#indexing-error` block (populated when
 *      `progress.metadata_error` is non-null). The pre-extracted helper
 *      `renderOpenClaudeCodeButton(container, errorMessage, idPrefix)`
 *      lets either banner mount its own button without duplicating the
 *      fetch + state machine.
 *
 * The function:
 *   - Builds a fresh `<button>` + result `<span>` pair inside `container`.
 *   - Wires the click handler to POST `/api/daemon/open-claude-code`.
 *   - Manages disabled / loading / launched / failed states inline so
 *     the operator never has to look elsewhere for the launch outcome.
 *
 * `idPrefix` keeps DOM ids unique across multiple instances on the same
 * page (otherwise the second mount would clash with the first).
 */
function renderOpenClaudeCodeButton(container, errorMessage, idPrefix) {
  if (!container) return;
  const btnId = idPrefix + '-btn';
  const resultId = idPrefix + '-result';

  const btn = document.createElement('button');
  btn.type = 'button';
  btn.id = btnId;
  btn.className = 'config-error-banner__btn config-error-banner__btn--ghost';
  btn.setAttribute('data-i18n', 'degraded.action.open_claude_code');
  btn.textContent = t('degraded.action.open_claude_code') || 'Open in Claude Code →';

  const resultBox = document.createElement('div');
  resultBox.id = resultId;
  resultBox.className = 'config-error-banner__inline-result';
  resultBox.hidden = true;

  btn.addEventListener('click', async () => {
    const originalLabel = btn.textContent;
    btn.disabled = true;
    btn.textContent = t('degraded.action.open_claude_code_launching') || 'Launching…';
    resultBox.hidden = true;
    resultBox.textContent = '';
    resultBox.classList.remove(
      'config-error-banner__inline-result--ok',
      'config-error-banner__inline-result--err'
    );

    try {
      const res = await fetch('/api/daemon/open-claude-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ error_message: errorMessage }),
      });
      const data = await res.json().catch(() => ({}));
      if (data && data.success) {
        resultBox.classList.add('config-error-banner__inline-result--ok');
        const pidPart = data.pid != null ? ` (PID ${data.pid})` : '';
        resultBox.textContent =
          (t('degraded.action.open_claude_code_launched') ||
            'Launched Claude Code at') +
          ' ' +
          (data.cwd || '?') +
          pidPart;
      } else {
        resultBox.classList.add('config-error-banner__inline-result--err');
        const detail = (data && data.error) || 'HTTP ' + res.status;
        resultBox.textContent =
          (t('degraded.action.open_claude_code_failed') || 'Failed') + ': ' + detail;
      }
    } catch (err) {
      resultBox.classList.add('config-error-banner__inline-result--err');
      resultBox.textContent =
        (t('degraded.action.open_claude_code_failed') || 'Failed') +
        ': ' +
        (err && err.message ? err.message : String(err));
    } finally {
      resultBox.hidden = false;
      btn.disabled = false;
      btn.textContent = originalLabel;
    }
  });

  container.appendChild(btn);
  container.appendChild(resultBox);
}

/**
