function showLicenseError(data) {
  // Issue #20405: if we're running inside the native wry webview and the window is
  // tray-hidden (daemon auto-spawn after consent), ask the native side to surface
  // it so a license error is never missed. Posted BEFORE the licenseErrorShown
  // early-return so a re-broadcast while hidden still re-reveals. `window.ipc` is
