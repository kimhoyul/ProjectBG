// ── Issue #8082: Asset Health (stale assets) ──
function updateStaleAssets(staleData) {
  const section = document.getElementById('asset-health-section');
  if (!section) return;
  if (!staleData || staleData.stale_count === 0) {
    section.style.display = 'none';
    return;
  }
  section.style.display = '';
  const badge = document.getElementById('stale-badge');
  document.getElementById('stale-count').textContent = staleData.stale_count;
  badge.className = 'stale-badge';

  // Version distribution
  const distEl = document.getElementById('stale-distribution');
  distEl.innerHTML = '';
  if (staleData.version_distribution) {
    Object.entries(staleData.version_distribution).sort((a,b) => b[1]-a[1]).forEach(([label, count]) => {
      const item = document.createElement('span');
      item.className = 'dist-item';
      item.textContent = label + ': ' + count;
      distEl.appendChild(item);
    });
  }

  // Stale samples
  const samplesEl = document.getElementById('stale-samples');
  samplesEl.innerHTML = '';
  if (staleData.stale_samples && staleData.stale_samples.length > 0) {
    staleData.stale_samples.forEach(s => {
      const div = document.createElement('div');
      div.className = 'sample';
      div.textContent = esc(s.path) + ' (' + esc(s.ue_version_label) + ')';
      samplesEl.appendChild(div);
    });
  }
}

function runResaveAssets(mode) {
  if (mode === 'stale_only' && !confirm(t('asset_health.resave_confirm'))) return;
  runAction('ue_cache_control', 'resave_assets', { mode: mode });
  showToast('info', t('toast.resave_started', mode));
}

