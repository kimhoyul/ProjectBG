// NarshaADK Dashboard - UE5 Theme - SSE + Interactive Controls
'use strict';

// ── i18n Module (Issue #8619) ──
const I18N = {
  _dict: {},
  _fallback: {},
  _lang: 'en',
  _available: {},
  _lastData: null,

  init(langData) {
    this._available = langData;
    this._fallback = langData['en'] || {};
    // One-time migration: clear stale lang pref so OS detection runs (Issue #8619)
    if (!localStorage.getItem('narsha_i18n_v1')) {
      localStorage.removeItem('narsha_lang');
      localStorage.setItem('narsha_i18n_v1', '1');
    }
    const saved = localStorage.getItem('narsha_lang');
    // Detect OS/browser language — try full code first for regional variants
    // (e.g. "zh-CN" → "zh-CN", "pt-BR" → "pt-BR", "ko-KR" → "ko", "en-US" → "en")
    var navLang = navigator.language || '';
    var detected = langData[navLang] ? navLang :
                   langData[navLang.split('-')[0]] ? navLang.split('-')[0] : 'en';
    this._lang = (saved && langData[saved]) ? saved : (langData[detected] ? detected : 'en');
    this._dict = langData[this._lang] || this._fallback;
    this._applyDOM();
    document.documentElement.lang = this._lang;
    this._updateDir();
  },

  setLang(lang) {
    if (!this._available[lang]) return;
    this._lang = lang;
    this._dict = this._available[lang];
    localStorage.setItem('narsha_lang', lang);
    document.documentElement.lang = lang;
    this._updateDir();
    this._applyDOM();
    // Sync all language selectors
    ['language-select', 'header-lang-select'].forEach(function(id) {
      var sel = document.getElementById(id);
      if (sel) sel.value = lang;
    });
    // Re-render dynamic content with new language
    if (this._lastData) updateOverview(this._lastData);
    if (memoryStatusLoaded) loadMemoryStatus();
    if (_lastAiClients) renderAiClients(_lastAiClients);
  },

  t(key) {
    var args = Array.prototype.slice.call(arguments, 1);
    var s = this._dict[key] || this._fallback[key] || key;
    for (var i = 0; i < args.length; i++) {
      s = s.replace('{' + i + '}', args[i]);
    }
    return s;
  },

  _applyDOM() {
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      el.textContent = I18N.t(el.getAttribute('data-i18n'));
    });
    // data-i18n-html: Only for static translation keys containing safe HTML
    // (e.g., <strong>, <code>). NEVER use for keys containing user input.
    document.querySelectorAll('[data-i18n-html]').forEach(function(el) {
      el.innerHTML = I18N.t(el.getAttribute('data-i18n-html'));
    });
    document.querySelectorAll('[data-i18n-title]').forEach(function(el) {
      el.title = I18N.t(el.getAttribute('data-i18n-title'));
    });
    document.title = I18N.t('page.title');
  },

  // Set text direction from _meta.dir (RTL for Arabic, LTR for others)
  _updateDir() {
    var meta = this._dict._meta || {};
    document.documentElement.dir = meta.dir || 'ltr';
  },

  getLangs() {
    return Object.keys(this._available).map(function(code) {
      var meta = I18N._available[code]._meta || {};
      return { code: code, name: meta.name || code };
    });
  }
};

function t() { return I18N.t.apply(I18N, arguments); }

const MAX_EVENTS = 50;
const MEMORY_CEILING_MB = 16384; // 16 GB — assumed max for progress bar display
const SSE_MAX_DELAY = 30000;
const eventLog = [];
let sseSource = null;
let sseRetryDelay = 1000;

// ── Tab Switching ──
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
  });
});

// ── SSE Connection ──
function connectSSE() {
  if (sseSource) sseSource.close();
  sseSource = new EventSource('/api/daemon/events');

  const badge = document.getElementById('connection-status');
  sseSource.onopen = () => {
    badge.textContent = t('header.healthy');
    badge.className = 'badge badge-green';
    sseRetryDelay = 1000; // reset backoff on success
  };

  sseSource.onerror = () => {
    badge.textContent = t('header.disconnected');
    badge.className = 'badge badge-red';
    setTimeout(connectSSE, sseRetryDelay);
    sseRetryDelay = Math.min(sseRetryDelay * 2, SSE_MAX_DELAY);
  };

  sseSource.addEventListener('heartbeat', (e) => {
    try { updateOverview(JSON.parse(e.data)); }
    catch (err) { console.error('SSE heartbeat parse error:', err); }
  });

  const eventTypes = ['session_connected', 'session_disconnected', 'tool_start', 'tool_end', 'stale_session_removed', 'daemon_shutdown'];
  eventTypes.forEach(type => {
    sseSource.addEventListener(type, (e) => {
      try { addEvent(type, JSON.parse(e.data)); }
      catch (err) { console.error('SSE event parse error:', err); }
    });
  });

  // Issue #8371: Memory transition event listeners
  const memTransitionTypes = ['memory_transition_started', 'memory_transition_progress', 'memory_transition_completed', 'memory_transition_failed'];
  memTransitionTypes.forEach(type => {
    sseSource.addEventListener(type, (e) => {
      try { handleMemoryTransitionEvent(type, JSON.parse(e.data)); }
      catch (err) { console.error('SSE memory transition parse error:', err); }
    });
  });

  // Issue #7972: License event listeners
  sseSource.addEventListener('license_error', (e) => {
    try { showLicenseError(JSON.parse(e.data)); }
    catch (err) { console.error('SSE license_error parse error:', err); }
  });

  // Issue #10769 PR 6: project-config change notification.
  // Backend `project_watcher` detects modifications to .uproject (release
  // users — UE Editor rewrites this on engine-version conversion),
  // .mcp.json, or .env (dev mode) and broadcasts this event. We show a
  // toast prompting the user to click Restart Daemon to apply the new
  // values. Wording is GENERIC ("Configuration changed: <kind>") because
  // most release users see this triggered by .uproject, not .env.
  sseSource.addEventListener('config_changed', (e) => {
    try {
      const data = JSON.parse(e.data);
      const reasonCount = (data.config_errors || []).length;
      const fileLabel = friendlyConfigFileLabel(data.path || '');
      const msg = reasonCount > 0
        ? t('degraded.config_changed.toast_with_errors', fileLabel, reasonCount)
        : t('degraded.config_changed.toast', fileLabel);
      showConfigChangedToast(msg);
    } catch (err) {
      console.error('SSE config_changed parse error:', err);
    }
  });
}

// Issue #10769 PR 6: Pick a short, localized label for the changed file.
// Full paths are often deep + locale-specific; for the toast we want
// a quick hint (".uproject" / ".mcp.json" / ".env") so the user knows
// what kind of file changed without reading a long path.
function friendlyConfigFileLabel(path) {
  if (!path) return t('degraded.config_changed.label_generic');
  const lower = path.toLowerCase();
  if (lower.endsWith('.uproject')) return t('degraded.config_changed.label_uproject');
  if (lower.endsWith('.mcp.json')) return t('degraded.config_changed.label_mcp_json');
  if (lower.endsWith('.env')) return t('degraded.config_changed.label_env');
  // Fallback: just the basename — short and informative enough.
  const slash = Math.max(path.lastIndexOf('/'), path.lastIndexOf('\\'));
  return slash >= 0 ? path.substring(slash + 1) : path;
}

// Issue #10769 PR 6: Toast with an inline Restart-Daemon button.
// Dedupes on .toast--config-changed so a busy editor (multiple saves
// in quick succession) doesn't stack duplicate toasts.
function showConfigChangedToast(message) {
  const container = document.getElementById('toast-container');
  if (!container) {
    console.info('[config_changed]', message);
    return;
  }
  let existing = container.querySelector('.toast--config-changed');
  if (existing) {
    const msgEl = existing.querySelector('.toast-message');
    if (msgEl) msgEl.textContent = message;
    return;
  }
  const toast = document.createElement('div');
  toast.className = 'toast toast--config-changed';
  toast.setAttribute('role', 'status');

  const msgEl = document.createElement('span');
  msgEl.className = 'toast-message';
  msgEl.textContent = message;
  toast.appendChild(msgEl);

  const btn = document.createElement('button');
  btn.className = 'toast-action';
  btn.type = 'button';
  btn.textContent = t('degraded.config_changed.restart_btn');
  btn.onclick = () => { restartDaemon(); toast.remove(); };
  toast.appendChild(btn);

  container.appendChild(toast);
  // 12s lets the user read + decide. Manual click of Restart any time before that.
  setTimeout(() => toast.remove(), 12000);
}

// ── Overview Updates ──
function updateOverview(data) {
  I18N._lastData = data;
  if (data.status) {
    document.getElementById('version').textContent = 'v' + data.status.version;
    document.getElementById('uptime').textContent = formatUptime(data.status.uptime_secs);
    document.getElementById('session-count').textContent = data.status.session_count;
    const sv = document.getElementById('settings-version');
    if (sv) sv.textContent = 'v' + data.status.version;
    const su = document.getElementById('settings-uptime');
    if (su) su.textContent = formatUptime(data.status.uptime_secs);
    // Server info (Issue #8470)
    const ss = document.getElementById('settings-sessions');
    if (ss) ss.textContent = data.status.session_count + ' ' + t('settings.active');
    const sp = document.getElementById('settings-project');
    if (sp && data.status.project_path) sp.textContent = data.status.project_path;
    const se = document.getElementById('settings-engine');
    if (se && data.status.engine_path) se.textContent = data.status.engine_path;
    const sb = document.getElementById('settings-binary');
    if (sb && data.status.binary_path) sb.textContent = data.status.binary_path;
    // Daemon executable path (Issue #11572): canonical absolute path of the running binary
    const sep = document.getElementById('settings-executable-path');
    if (sep && data.status.executable_path) sep.textContent = data.status.executable_path;
    // Cache path (Intermediate/NarshaMCP/)
    const sc = document.getElementById('settings-cache');
    if (sc && data.status.project_path) sc.textContent = data.status.project_path + '/Intermediate/NarshaMCP';
    // License status
    const sl = document.getElementById('settings-license');
    const lh = document.getElementById('license-hint');
    if (sl) {
      if (data.license_error) {
        sl.textContent = data.license_error.message || data.license_error.error_type || t('error.generic');
        sl.style.color = 'var(--red)';
        if (lh) lh.style.display = '';
      } else if (data.license_verified) {
        sl.textContent = t('settings.license_verified');
        sl.style.color = 'var(--green)';
        if (lh) lh.style.display = 'none';
      } else {
        sl.textContent = t('settings.license_not_verified');
        sl.style.color = 'var(--text-dim)';
        if (lh) lh.style.display = '';
      }
    }
    if (data.status.project_path) {
      document.getElementById('project-path').textContent = data.status.project_path;
    }
    if (data.status.engine_path) {
      document.getElementById('engine-path').textContent = data.status.engine_path;
    }
    if (data.status.memory_mb != null) {
      document.getElementById('memory-value').textContent = data.status.memory_mb.toLocaleString();
      const pct = Math.min(100, (data.status.memory_mb / MEMORY_CEILING_MB) * 100);
      const fill = document.getElementById('memory-fill');
      if (fill) fill.style.width = pct + '%';
    }
    if (data.status.cpu_usage_percent != null) {
      document.getElementById('cpu-value').textContent = data.status.cpu_usage_percent.toFixed(1);
      const chip = document.getElementById('cpu-value').closest('.status-chip');
      if (chip && data.status.cpu_cores) {
        chip.title = data.status.cpu_cores + ' logical cores';
      }
    }
    // Issue #10769: configuration-error banner. Surfaces startup-validation
    // problems when the daemon enters degraded mode (PR 5+). Hidden when the
    // daemon is healthy (degraded_mode === false or undefined for old daemons).
    applyDegradedBanner(data.status);
  }

  if (data.sessions) {
    const tbody = document.querySelector('#sessions-table tbody');
    tbody.innerHTML = '';
    if (data.sessions.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4"><div class="empty-state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="11" x2="19" y2="17"/></svg><p>' + esc(t('sessions.no_active')) + '</p></div></td></tr>';
    } else {
      data.sessions.forEach(s => {
        const tr = document.createElement('tr');
        tr.innerHTML = '<td>' + esc(s.id.substring(0, 8)) + '</td>'
          + '<td>' + esc(s.hostname || '-') + '</td>'
          + '<td>' + esc(String(s.request_count || 0)) + '</td>'
          + '<td>' + esc(formatAge(s.connected_at)) + '</td>';
        tbody.appendChild(tr);
      });
    }
  }

  if (data.progress) {
    updateIndexing(data.progress);
  }

  // Issue #7872: Sync engine config dropdowns + PDB status from heartbeat
  if (data.engine_config) {
    updateEngineConfig(data.engine_config);
  }

  // Issue #8453: Engine docs hydration status
  if (data.engine_docs) {
    updateEngineDocs(data.engine_docs);
  }

  // Issue #7860: Sync telemetry consent state
  if (data.telemetry) {
    updateTelemetry(data.telemetry);
  }

  // Issue #8082: Stale asset health
  if (data.status && data.status.stale_assets) {
    updateStaleAssets(data.status.stale_assets);
  }

  // Issue #7972: Show license status from heartbeat (late-connecting clients)
  if (data.license_error) {
    showLicenseError(data.license_error);
  }
  if (data.license_verified && !licenseVerifiedShown) {
    licenseVerifiedShown = true;
    showLicenseSuccess();
  }
}

// ── Engine Config Sync ──
// Skip heartbeat overwrite for 5s after user changes a config value
let _cfgCooldown = 0;
function markConfigChanged() {
  _cfgCooldown = Date.now() + 5000;
}

let lastEngineConfig = null; // Issue #8866: cached for instant PDB status update on mode change
function updateEngineConfig(cfg) {
  lastEngineConfig = cfg;
  // Skip sync while user just changed a value (wait for server to process)
  const inCooldown = Date.now() < _cfgCooldown;

  // Runtime settings — sync dropdowns/toggles to actual server state
  if (!inCooldown) {
    const modeSelect = document.getElementById('engine-source-mode');
    if (modeSelect && cfg.engine_source_mode) {
      modeSelect.value = cfg.engine_source_mode;
    }
    const parserSelect = document.getElementById('engine-parser');
    if (parserSelect && cfg.engine_parser) {
      parserSelect.value = cfg.engine_parser;
    }
    const fwBtn = document.getElementById('file-watcher-toggle');
    if (fwBtn && cfg.file_watcher_enabled !== undefined) {
      fwBtn.classList.toggle('on', cfg.file_watcher_enabled === true);
      fwBtn.textContent = cfg.file_watcher_enabled ? 'ON' : 'OFF';
    }
    const arBtn = document.getElementById('auto-regenerate-toggle');
    if (arBtn && cfg.auto_generate_metadata !== undefined) {
      arBtn.classList.toggle('on', cfg.auto_generate_metadata === true);
      arBtn.textContent = cfg.auto_generate_metadata ? 'ON' : 'OFF';
    }
  }

  // PDB Load Config — 4-state display (Issue #7971, #8866)
  // Cross-reference config flags with runtime pdb_categories indexed status
  const pdbPanel = document.getElementById('pdb-load-status');
  if (pdbPanel) {
    const cats = cfg.pdb_categories || [];
    const catMap = {};
    cats.forEach(c => { catMap[c.label] = c; });

    const items = [
      { label: t('pdb.core'),              config: cfg.load_engine_core,        cat: 'EngineCore' },
      { label: t('pdb.runtime'),           config: cfg.load_engine_runtime,     cat: 'EngineRuntime' },
      { label: t('pdb.editor'),            config: cfg.load_engine_editor,      cat: 'EngineEditor' },
      { label: t('pdb.engine_plugins'),    config: cfg.load_engine_plugins,     cat: 'EnginePlugin' },
      { label: t('pdb.engine_collection'), config: cfg.include_engine_pdb,      cat: null },
      { label: t('pdb.engine_metadata'),   config: cfg.include_engine_metadata, cat: null },
    ];

    pdbPanel.innerHTML = items.map(item => {
      let catInfo = item.cat ? catMap[item.cat] : null;
      // Fallback: EngineCore often merged into EngineRuntime
      if (!catInfo && item.cat === 'EngineCore') catInfo = catMap['EngineRuntime'];
      const indexed = catInfo ? catInfo.indexed : (item.cat ? false : item.config === true);
      // Issue #8866: When no catInfo exists, compute needsRegen from config+indexed
      // so newly-enabled categories show yellow instead of staying gray
      const needsRegen = catInfo ? !!catInfo.needs_regen : (item.config === true && !indexed);
      return pdbStatusItem(item.label, item.config, indexed, needsRegen);
    }).join('');
  }
}

function pdbStatusItem(label, configEnabled, indexed, needsRegen) {
  let cls, text;
  if (!configEnabled) {
    cls = 'disabled'; text = t('pdb.off');
  } else if (needsRegen) {
    cls = 'needs-regen'; text = t('pdb.needs_regen');
  } else if (indexed) {
    cls = 'loaded'; text = t('pdb.loaded');
  } else {
    cls = 'pending'; text = t('pdb.pending');
  }
  return '<div class="pdb-status-item">'
    + '<span class="status-dot ' + cls + '"></span>'
    + '<span>' + esc(label) + ': ' + text + '</span>'
    + '</div>';
}

// ── Detailed Indexing (TUI-level) ──
function updateIndexing(progress) {
  const container = document.getElementById('indexing-container');
  container.innerHTML = '';

  // Status + symbols in status bar
  const statusEl = document.getElementById('indexing-status');
  const rawStatus = progress.indexing_status || '--';
  // User-friendly status labels
  const statusMap = {
    'Complete': t('indexing.complete'),
    'Running': t('indexing.indexing') + '...',
    'Pending': t('indexing.starting'),
    'Loading': t('indexing.loading_cache'),
    'Unknown': '--',
  };
  const displayStatus = statusMap[rawStatus] || rawStatus;
  // Header reflects overall indexing state: PDB + Metadata (Issue #8113)
  const isPdbActive = rawStatus === 'Running' || rawStatus === 'Pending' || rawStatus === 'Loading' || rawStatus === 'Indexing';
  const isMetadataActive = progress.metadata_progress && progress.metadata_progress.in_progress;
  const isActive = isPdbActive || isMetadataActive;
  if (isActive) {
    statusEl.innerHTML = esc(t('indexing.indexing')) + '<span class="indexing-dots"><span>.</span><span>.</span><span>.</span></span>';
    statusEl.style.color = 'var(--yellow)';
    statusEl.style.fontWeight = '600';
  } else if (rawStatus === 'Complete') {
    statusEl.textContent = t('indexing.complete');
    statusEl.style.color = 'var(--green)';
    statusEl.style.fontWeight = '';
    // Restore Regenerate button when indexing completes
    var rBtn = document.querySelector('button[onclick="regenerateAll()"]');
    if (rBtn) { rBtn.disabled = false; rBtn.textContent = t('controls.regenerate_all'); }
  } else {
    statusEl.textContent = displayStatus;
    statusEl.style.color = 'var(--text-dim)';
    statusEl.style.fontWeight = '';
  }

  // Symbols count
  const totalSymbols = progress.total_symbols;
  if (totalSymbols != null && totalSymbols > 0) {
    const symStr = totalSymbols >= 1000000
      ? (totalSymbols / 1000000).toFixed(1) + 'M'
      : totalSymbols >= 1000
        ? Math.round(totalSymbols / 1000) + 'K'
        : String(totalSymbols);
    document.getElementById('symbols-value').textContent = symStr;
  } else {
    document.getElementById('symbols-value').textContent = '--';
  }

  // PDB Progress — show even when indexing (total > 0 OR actively running)
  if (progress.pdb_progress) {
    const p = progress.pdb_progress;
    if (p.total_pdbs > 0 || p.percent > 0) {
      // Snapshot restore reports indexed_pdbs=0 but percent=100 — show as complete
      const displayCurrent = (p.percent >= 100 && p.indexed_pdbs === 0) ? p.total_pdbs : p.indexed_pdbs;
      container.appendChild(makeDetailedProgress(t('indexing.pdb'), displayCurrent, p.total_pdbs, 'green'));
    }
  }

  // Metadata Progress — show loading state
  if (progress.metadata_progress) {
    const m = progress.metadata_progress;
    if (m.in_progress && m.total > 0) {
      // Actively generating metadata
      container.appendChild(makeDetailedProgress(t('indexing.metadata_generating'), m.processed, m.total, 'cyan'));
    } else if (m.in_progress) {
      // Loading/waiting state
      const row = document.createElement('div');
      row.className = 'progress-row';
      row.innerHTML = '<div class="progress-label"><span class="label">' + esc(t('indexing.metadata')) + '</span>'
        + '<span class="detail" style="color:var(--yellow)">' + esc(t('indexing.metadata_loading')) + '</span></div>'
        + '<div class="progress-bar"><div class="progress-fill cyan" style="width:30%;animation:pulse 1.5s infinite"></div></div>';
      container.appendChild(row);
    } else if (m.node_count > 0) {
      // Complete
      const row = document.createElement('div');
      row.className = 'progress-row';
      row.innerHTML = '<div class="progress-label"><span class="label">' + esc(t('indexing.metadata')) + '</span>'
        + '<span class="detail"><span style="color:var(--green)">' + esc(String(m.node_count.toLocaleString())) + '</span> ' + esc(t('indexing.nodes')) + ', '
        + '<span style="color:var(--green)">' + esc(String(m.blueprint_count)) + '</span> ' + esc(t('indexing.bps')) + '</span></div>'
        + '<div class="progress-bar"><div class="progress-fill complete" style="width:100%"></div></div>';
      container.appendChild(row);
    }
  }

  // Cross-Reference Index
  if (progress.cross_ref_index && progress.cross_ref_index.total_blueprints > 0) {
    const x = progress.cross_ref_index;
    const row = document.createElement('div');
    row.className = 'progress-row';
    row.innerHTML = '<div class="progress-label"><span class="label">' + esc(t('indexing.cross_ref')) + '</span>'
      + '<span class="detail">'
      + '<span style="color:var(--green)">' + esc(String(x.total_blueprints)) + '</span> ' + esc(t('indexing.bps')) + ', '
      + '<span style="color:var(--green)">' + esc(String(x.total_call_edges)) + '</span> ' + esc(t('indexing.calls')) + ', '
      + '<span style="color:var(--green)">' + esc(String(x.total_delegate_edges)) + '</span> ' + esc(t('indexing.delegates'))
      + (x.build_time_ms > 0 ? '  (' + esc(String((x.build_time_ms / 1000).toFixed(1))) + 's)' : '')
      + '</span></div>';
    container.appendChild(row);
  }

  // Show "empty" state if nothing is indexed and not actively running
  if (container.children.length === 0 && !isActive) {
    container.innerHTML = '<div style="color:var(--text-dim);font-size:11px;padding:8px 0">' + esc(t('indexing.no_data')) + '</div>';
  }

  // PDB Categories
  const pdbCatEl = document.getElementById('pdb-categories');
  pdbCatEl.innerHTML = '';
  if (progress.pdb_categories && progress.pdb_categories.length > 0) {
    const title = document.createElement('div');
    title.className = 'category-section-title';
    title.style.cssText = 'display:flex;justify-content:space-between;align-items:center';
    const symStr = document.getElementById('symbols-value').textContent;
    title.innerHTML = esc(t('categories.pdb_sources')) + (symStr && symStr !== '--' ? '<span style="font-size:11px;color:var(--green);font-weight:600">' + esc(symStr) + ' ' + esc(t('indexing.symbols')) + '</span>' : '');
    pdbCatEl.appendChild(title);
    progress.pdb_categories.forEach(c => {
      pdbCatEl.appendChild(makeCategoryRow(c.label, c.count, c.indexed));
    });
  }

  // Meta Categories
  const metaCatEl = document.getElementById('meta-categories');
  metaCatEl.innerHTML = '';
  if (progress.meta_categories && progress.meta_categories.length > 0) {
    const title = document.createElement('div');
    title.className = 'category-section-title';
    title.textContent = t('categories.metadata_sources');
    metaCatEl.appendChild(title);
    progress.meta_categories.forEach(c => {
      metaCatEl.appendChild(makeCategoryRow(c.label, c.count, c.parsed));
    });
  }

  // Error
  const errorEl = document.getElementById('indexing-error');
  errorEl.innerHTML = '';
  const errMsg = progress.metadata_error;
  if (errMsg) {
    // Banner stays the same shape it always had — single .error-banner div.
    // The "Open in Claude Code →" button is appended as a sibling so the
    // banner CSS is untouched and the helper owns its own state.
    const bannerHost = document.createElement('div');
    const bannerInner = document.createElement('div');
    bannerInner.className = 'error-banner';
    bannerInner.textContent = errMsg;  // textContent instead of innerHTML + esc() — same XSS-safety, no escaping ambiguity
    bannerHost.appendChild(bannerInner);
    // idPrefix carries 'indexing-error' so the spawned button + result
    // ids stay unique against the degraded-mode banner's static ids
    // (`open-claude-code-btn` / `-result`) which still live in the DOM.
    renderOpenClaudeCodeButton(bannerHost, errMsg, 'open-claude-code-indexing');
    errorEl.appendChild(bannerHost);
  }
}

function makeDetailedProgress(label, current, total, color) {
  const rawPct = total > 0 ? Math.round((current / total) * 100) : 0;
  const pct = Math.min(rawPct, 100); // Cap at 100% (counters may accumulate across regenerations)
  const isComplete = pct >= 100;
  const displayCurrent = Math.min(current, total); // Don't show > total
  const div = document.createElement('div');
  div.className = 'progress-row';
  div.innerHTML = '<div class="progress-label">'
    + '<span class="label">' + label + '</span>'
    + '<span class="detail">'
    + displayCurrent.toLocaleString() + '/' + total.toLocaleString()
    + ' (' + pct + '%)'
    + '</span></div>'
    + '<div class="progress-bar"><div class="progress-fill ' + (isComplete ? 'complete' : color) + '" style="width:' + pct + '%"></div></div>';
  return div;
}

function makeCategoryRow(label, count, done) {
  const div = document.createElement('div');
  div.className = 'category-chip';
  const st = done ? 'done' : 'pending';
  div.innerHTML = '<span class="category-dot ' + st + '"></span>'
    + '<span class="category-name">' + esc(label) + '</span>'
    + '<span class="category-badge ' + st + '">' + count.toLocaleString() + '</span>';
  return div;
}

// ── Event Log ──
function addEvent(type, data) {
  const now = new Date().toLocaleTimeString();
  const typeClass = type.replace(/_/g, '-');
  let detail = '';
  if (data.session_id) detail += data.session_id.substring(0, 8);
  if (data.tool) detail += ' ' + data.tool;
  if (data.operation) detail += '.' + data.operation;

  eventLog.unshift({ time: now, type, typeClass, detail });
  if (eventLog.length > MAX_EVENTS) eventLog.pop();
  renderEvents();
}

function renderEvents() {
  const container = document.getElementById('event-log');
  container.innerHTML = eventLog.map(e =>
    '<div class="event-entry evt-' + e.typeClass + '"><span class="event-time">' + e.time
    + '</span><span class="event-badge ' + e.typeClass + '">' + e.type
    + '</span><span>' + esc(e.detail) + '</span></div>'
  ).join('');
}

