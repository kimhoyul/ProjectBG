// ── Result Formatting ──
function formatResult(result) {
  // MCP tools return {content: [{type:"text", text: "JSON string"}]}
  // Extract the inner text and parse it for pretty display
  try {
    const text = result?.content?.[0]?.text;
    if (text) {
      try {
        const parsed = JSON.parse(text);
        return JSON.stringify(parsed, null, 2);
      } catch (e) {
        // Not JSON — return raw text (e.g. plain string responses)
        return text;
      }
    }
  } catch (e) { /* fall through */ }
  // Fallback: stringify the whole result
  return JSON.stringify(result, null, 2);
}

// ── Actions ──
async function runAction(tool, operation, params) {
  const btn = event ? event.target : null;
  if (btn) { btn.classList.add('loading'); btn.disabled = true; }

  try {
    const resp = await fetch('/api/daemon/action', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tool, operation, params: params || {} })
    });
    const result = await resp.json();

    const activeTab = document.querySelector('.tab.active').dataset.tab;
    const panel = document.getElementById(activeTab + '-result')
      || document.getElementById('dashboard-result');

    if (result.success) {
      panel.textContent = formatResult(result.result);
      panel.style.color = 'var(--text)';
      showToast('success', tool + '.' + operation + ' (' + result.duration_ms + 'ms)');
    } else {
      // Issue #16145: the action endpoint now reports top-level success:false for
      // tool errors (incl. cost-guard rejections). Surface the machine error_code
      // (e.g. confirm_required) as a tag prefix so the user can tell a retriable
      // failure from a fatal one; the human message stays in result.error.
      const body = result.error || t('toast.action_failed');
      const msg = result.error_code ? '[' + result.error_code + '] ' + body : body;
      panel.textContent = msg;
      panel.style.color = 'var(--red)';
      showToast('error', msg);
    }
  } catch (err) {
    showToast('error', t('toast.network_error', err.message));
  } finally {
    if (btn) { btn.classList.remove('loading'); btn.disabled = false; }
  }
}

function confirmAction(name, tool, operation, params) {
