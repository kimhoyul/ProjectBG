@echo off
title NarshaMCP Dashboard
REM =========================================================
REM NarshaMCP Dashboard Launcher (Issue #8294)
REM Generated by install-to-plugin.bat — do not edit manually
REM =========================================================

set "NARSHAMCP_EXE={{NARSHAMCP_EXE}}"
set "PROJECT_PATH={{PROJECT_PATH}}"

if not exist "%NARSHAMCP_EXE%" (
    echo [ERROR] narshamcp.exe not found at:
    echo   %NARSHAMCP_EXE%
    echo.
    echo Please reinstall NarshaMCP or verify Plugins\NarshaMCP exists.
    pause
    exit /b 1
)

echo Starting NarshaMCP Dashboard...
echo   Project: %PROJECT_PATH%
echo.
"%NARSHAMCP_EXE%" daemon --project-path "%PROJECT_PATH%"
